+const CpuArena = struct {
+    bytes: []u8,
+    at: usize = 0,
+    fn take(a: *CpuArena, n: usize) !u64 {
+        const at = std.mem.alignForward(usize, a.at, 256);
+        if (at + n > a.bytes.len) return error.OutOfMemory;
+        a.at = at + n;
+        return @intFromPtr(a.bytes.ptr + at);
+    }
+};
+
+/// The exact same generic capture/retain methods run against byte-addressed CPU
+/// storage here, so tests exercise strides, -1 padding and retained-copy isolation.
+const CpuGpu = struct {
+    const Stream = struct { handle: usize = 0 };
+    const Driver = struct {
+        const Api = struct {
+            cuMemsetD8Async: *const fn (u64, u8, usize, usize) i32 = memset,
+            fn memset(dst: u64, value: u8, n: usize, _: usize) i32 {
+                const bytes: [*]u8 = @ptrFromInt(dst);
+                @memset(bytes[0..n], value);
+                return 0;
+            }
+        };
+        api: Api = .{},
+        fn check(_: *const Driver, status: i32, _: []const u8) !void {
+            if (status != 0) return error.CpuCopyFailed;
+        }
+    };
+    const Ops = struct {
+        fn copyRows(_: *const Ops, _: Stream, src: u64, ss: usize, dst: u64, ds: usize, width: usize, n: usize) !void {
+            const from: [*]const u8 = @ptrFromInt(src);
+            const to: [*]u8 = @ptrFromInt(dst);
+            for (0..n) |i| @memcpy(to[i * ds ..][0..width], from[i * ss ..][0..width]);
+        }
+    };
+    s: Stream = .{},
+    d: *const Driver,
+    ops: *const Ops,
+};
