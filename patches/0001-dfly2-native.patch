diff --git a/zig/src/families/dsv41/dfly.zig b/zig/src/families/dsv41/dfly.zig
new file mode 100644
index 000000000..e9cca06f1
--- /dev/null
+++ b/zig/src/families/dsv41/dfly.zig
@@ -0,0 +1,352 @@
+//! Standalone DeepSeek DFly2 B6 on a TP2 target. This is not DSpark: it reads
+//! target KV/index selections, fuses the preceding target hidden into slot0,
+//! and samples slots1..5 with sequential hidden/attentive correction.
+//! Initial implementation deliberately supports one stream, replicated KV,
+//! eager execution and greedy draft proposals. Target verification is unchanged.
+const std = @import("std");
+const prompt = @import("prompt.zig");
+const cache = @import("dfly_cache.zig");
+const weights = @import("dfly_weights.zig");
+const base_weights = @import("weights.zig");
+const basic = @import("tri_basic.zig");
+const hc = @import("tri_hc.zig");
+const norm = @import("tri_norm.zig");
+const Kernels = @import("dfly_kernels.zig").Kernels;
+const Engine = prompt.Engine;
+const Chunk = prompt.Chunk;
+const Linear = base_weights.Linear;
+
+pub const max_streams = 16;
+pub const block_size = 6;
+pub const max_drafts = 5;
+const D = 5120;
+const HD = 512;
+const H = 32;
+const Q = 1280;
+const I = 1152;
+const R = block_size;
+const mask_token: i64 = 128799;
+
+fn ci(v: usize) i32 {
+    return @intCast(v);
+}
+fn blocks(n: usize) usize {
+    return (n + 255) / 256;
+}
+
+pub const Drafter = struct {
+    w: *const weights.Weights,
+    k: Kernels,
+    ids: u64,
+    positions: u64,
+    single_position: u64,
+    none: u64,
+    h: u64,
+    h_alt: u64,
+    x: u64,
+    part: u64,
+    pre: u64,
+    pre_a: u64,
+    pre_f: u64,
+    post: u64,
+    comb: u64,
+    qa: u64,
+    qr: u64,
+    q: u64,
+    ykv: u64,
+    kvb: u64,
+    o: u64,
+    group_in: u64,
+    group_out: u64,
+    u: u64,
+    dense_out: u64,
+    partial: u64,
+    gathered: u64,
+    context: [3]u64,
+    valid: [3]u64,
+    pick: u64,
+    route_weights: u64,
+    mg: u64,
+    mu: u64,
+    ma: u64,
+    md: u64,
+    sg: u64,
+    su: u64,
+    sa: u64,
+    sd: u64,
+    collapsed: u64,
+    normalized: u64,
+    concat: u64,
+    fusion: u64,
+    cg: u64,
+    cu: u64,
+    ca: u64,
+    delta: u64,
+    corrected: u64,
+    correction_keys: u64,
+    block_gate: u64,
+    head_input: u64,
+    logits: u64,
+    best: u64,
+    best_all: u64,
+    drafts: [max_streams][max_drafts]i64 = undefined,
+    streams: usize = 0,
+    steps: usize = 0,
+
+    pub fn init(e: *const Engine, a: *prompt.Arena, w: *const weights.Weights) !Drafter {
+        if (e.world != 2 or e.two != null or e.kv != null) return error.DFly2RequiresReplicatedTP2;
+        if (e.c.hidden != D or e.c.head_dim != HD or e.c.hc != 4) return error.DFly2TargetShapeMismatch;
+        var k = try Kernels.load(e.d);
+        errdefer k.deinit();
+        var dr: Drafter = undefined;
+        dr.w = w;
+        dr.k = k;
+        dr.streams = 0;
+        dr.steps = 0;
+        dr.ids = try a.take(R * 8);
+        dr.positions = try a.take(R * 8);
+        // The deployed AOT RoPE variants require a16-byte-aligned POS pointer,
+        // including one-row calls. Odd slot offsets in positions are only8-aligned.
+        dr.single_position = try a.take(16);
+        dr.none = try a.take(R * 8);
+        dr.h = try a.take(R * 4 * D * 2);
+        dr.h_alt = try a.take(R * 4 * D * 2);
+        dr.x = try a.take(R * D * 2);
+        dr.part = try a.take(R * basic.hc_blocks * 32 * 4);
+        dr.pre = try a.take(R * 4 * 4);
+        dr.pre_a = try a.take(R * 4 * 4);
+        dr.pre_f = try a.take(R * 4 * 4);
+        dr.post = try a.take(R * 4 * 4);
+        dr.comb = try a.take(R * 16 * 4);
+        dr.qa = try a.take(R * Q * 2);
+        dr.qr = try a.take(R * Q * 2);
+        dr.q = try a.take(R * H * HD * 2);
+        dr.ykv = try a.take(R * HD * 2);
+        dr.kvb = try a.take(R * HD * 2);
+        dr.o = try a.take(R * H * HD * 2);
+        dr.group_in = try a.take(R * 4096 * 2);
+        dr.group_out = try a.take(R * 1024 * 2);
+        dr.u = try a.take(R * 4096 * 2);
+        dr.dense_out = try a.take(R * D * 2);
+        dr.partial = try a.take(R * D * 4);
+        dr.gathered = try a.take(2 * R * D * 4);
+        for (0..3) |j| {
+            dr.context[j] = try a.take(640 * HD * 2);
+            dr.valid[j] = try a.take(640 * 4);
+        }
+        dr.pick = try a.take(R * 3 * 4);
+        dr.route_weights = try a.take(R * 3 * 4);
+        dr.mg = try a.take(R * 3 * I * 2);
+        dr.mu = try a.take(R * 3 * I * 2);
+        dr.ma = try a.take(R * 3 * I * 2);
+        dr.md = try a.take(R * 3 * D * 2);
+        dr.sg = try a.take(R * I * 2);
+        dr.su = try a.take(R * I * 2);
+        dr.sa = try a.take(R * I * 2);
+        dr.sd = try a.take(R * D * 2);
+        dr.collapsed = try a.take(R * D * 2);
+        dr.normalized = try a.take(R * D * 2);
+        dr.concat = try a.take(2 * D * 2);
+        dr.fusion = try a.take(D * 2);
+        const correction_width: usize = w.correction.gate_proj.n;
+        dr.cg = try a.take(correction_width * 2);
+        dr.cu = try a.take(correction_width * 2);
+        dr.ca = try a.take(correction_width * 2);
+        dr.delta = try a.take(D * 2);
+        dr.corrected = try a.take(D * 2);
+        dr.correction_keys = try a.take(R * HD * 2);
+        dr.block_gate = try a.take(H * 2);
+        // prompt.grouped may pad the single-row shared target head. Keep its
+        // input separate from correction scratch, with initialized padding.
+        const head_rows = @max(R, e.plain_rows);
+        dr.head_input = try a.take(head_rows * D * 2);
+        try prompt.fill(e, dr.head_input, 0, head_rows * D * 2);
+        dr.logits = try a.take(head_rows * e.w.head.n * 4);
+        dr.best = try a.take(2 * 4);
+        dr.best_all = try a.take(2 * 2 * 4);
+        var no: [R]i64 = @splat(-1);
+        try prompt.upload(e, dr.none, &no, no.len * 8);
+        try e.s.synchronize(); // upload source has automatic storage
+        return dr;
+    }
+
+    pub fn deinit(dr: *Drafter) void {
+        dr.k.deinit();
+    }
+
+    fn linear(e: *const Engine, l: Linear, x: u64, y: u64, rows: usize) !void {
+        if (l.plain == 0) return error.DFly2DenseWeightsRequired;
+        try e.blas.linearBf16(x, l.plain, y, rows, l.k, l.n);
+    }
+
+    fn concatNorm(dr: *Drafter, e: *const Engine, x: u64, y: u64, wx: u64, wy: u64) !void {
+        try dr.k.run(e.s, "norm_concat", .{ 1, 1, 1 }, 256, .{ x, y, wx, wy, dr.concat, ci(D), e.c.eps });
+    }
+
+    fn normQuery(dr: *Drafter, e: *const Engine, q_norm: u64, wq_b: Linear, rows: usize, positions: u64) !void {
+        try basic.rmsnorm(e.t, dr.qa, Q, q_norm, dr.qr, Q, e.c.eps, rows, Q);
+        try linear(e, wq_b, dr.qr, dr.q, rows);
+        try norm.ropeHeads(e.t, dr.q, e.compressed.cos, e.compressed.sin, positions, 64, false, rows, H, HD);
+    }
+
+    fn output(dr: *Drafter, e: *const Engine, wo_a: [4]Linear, wo_b: Linear, rows: usize, positions: u64) !void {
+        try norm.ropeHeads(e.t, dr.o, e.compressed.cos, e.compressed.sin, positions, 64, true, rows, H, HD);
+        for (wo_a, 0..) |wa, g| {
+            if (wa.k != 4096 or wa.n != 1024) return error.DFly2OutputShapeMismatch;
+            try e.ops.copyRows(e.s, dr.o + g * 4096 * 2, H * HD * 2, dr.group_in, 4096 * 2, 4096 * 2, rows);
+            try linear(e, wa, dr.group_in, dr.group_out, rows);
+            try e.ops.copyRows(e.s, dr.group_out, 1024 * 2, dr.u + g * 1024 * 2, 4096 * 2, 1024 * 2, rows);
+        }
+        try linear(e, wo_b, dr.u, dr.dense_out, rows);
+        try e.ops.toF32(e.s, dr.dense_out, dr.partial, rows * D);
+    }
+
+    fn gatherPartial(dr: *Drafter, e: *const Engine, rows: usize) !void {
+        try e.gatherF32(dr.partial, dr.gathered, rows * D);
+    }
+
+    fn sumPartial(dr: *Drafter, e: *const Engine, out: u64, rows: usize) !void {
+        try dr.gatherPartial(e, rows);
+        try e.ops.add2Bf16(e.s, dr.gathered, dr.gathered + rows * D * 4, out, rows * D);
+    }
+
+    fn mixes(dr: *Drafter, e: *const Engine, h: u64, spare: *u64, pending: *bool, params: [3]u64, pre_in: u64, norm_w: u64, pre_out: u64) !u64 {
+        // The installed kit has plain RB2 and posted RB3/4/8, but no posted
+        // RB2 specialization (our six-row block). Materialize the identical
+        // post separately, then use the recorded plain six-row mix.
+        var src = h;
+        if (pending.*) {
+            src = spare.*;
+            try basic.hcPost(e.t, dr.gathered, h, dr.post, dr.comb, src, 2, R, D);
+            spare.* = h;
+            pending.* = false;
+        }
+        return hc.hcPre2(e.t, src, params[0], params[1], params[2], pre_in, norm_w, e.c.eps, e.c.hc_eps, e.c.hc_iters, dr.x, pre_out, dr.post, dr.comb, dr.part, null, null, R, D);
+    }
+
+    fn attend(dr: *Drafter, e: *const Engine, layer: usize) !void {
+        const l = dr.w.layers[layer].attn;
+        try linear(e, l.wq_a, dr.x, dr.qa, R);
+        try dr.normQuery(e, l.q_norm, l.wq_b, R, dr.positions);
+        try linear(e, l.wkv, dr.x, dr.ykv, R);
+        // DFly2 block latents are BF16, not the target's FP8-quantized SWA rows.
+        try basic.rmsnorm(e.t, dr.ykv, HD, l.kv_norm, dr.kvb, HD, e.c.eps, R, HD);
+        try norm.ropeHeads(e.t, dr.kvb, e.compressed.cos, e.compressed.sin, dr.positions, 64, false, R, 1, HD);
+        try dr.k.run(e.s, "attention", .{ R * H, 1, 1 }, 256, .{ dr.q, dr.context[layer], dr.valid[layer], dr.kvb, l.sink, dr.o, ci(H), ci(R), ci(R) });
+        try dr.output(e, l.wo_a, l.wo_b, R, dr.positions);
+    }
+
+    fn fp4(dr: *Drafter, e: *const Engine, m: weights.Mxfp4Experts, x: u64, out: u64, expert_input: bool) !void {
+        if (m.count != 128 or m.k % 32 != 0) return error.DFly2ExpertShapeMismatch;
+        try dr.k.run(e.s, "fp4", .{ (@as(usize, m.n) + 3) / 4, R * 3, 1 }, 128, .{ m.codes, m.scales, x, dr.pick, out, @as(i32, @intCast(m.n)), @as(i32, @intCast(m.k)), ci(R), @as(i32, @intFromBool(expert_input)) });
+    }
+
+    fn moe(dr: *Drafter, e: *const Engine, j: usize) !void {
+        const l = dr.w.layers[j];
+        try dr.k.run(e.s, "route", .{ R, 1, 1 }, 256, .{ dr.x, l.attn.gate_w, l.attn.gate_b, dr.pick, dr.route_weights, ci(D) });
+        try dr.fp4(e, l.w1, dr.x, dr.mg, false);
+        try dr.fp4(e, l.w3, dr.x, dr.mu, false);
+        try dr.k.run(e.s, "silu", .{ blocks(R * 3 * I), 1, 1 }, 256, .{ dr.mg, dr.mu, dr.ma, ci(R * 3 * I), @as(f32, 10) });
+        try dr.fp4(e, l.w2, dr.ma, dr.md, true);
+        try linear(e, l.shared_w1, dr.x, dr.sg, R);
+        try linear(e, l.shared_w3, dr.x, dr.su, R);
+        try dr.k.run(e.s, "silu", .{ blocks(R * I), 1, 1 }, 256, .{ dr.sg, dr.su, dr.sa, ci(R * I), @as(f32, 10) });
+        try linear(e, l.shared_w2, dr.sa, dr.sd, R);
+        try dr.k.run(e.s, "mix_experts", .{ blocks(R * D), 1, 1 }, 256, .{ dr.md, dr.sd, dr.route_weights, dr.partial, ci(D), ci(R) });
+    }
+
+    fn correctionInput(dr: *Drafter, e: *const Engine, slot: usize, previous: i64) !void {
+        const c = dr.w.correction;
+        try e.ops.copyRows(e.s, dr.positions + slot * 8, 8, dr.single_position, 8, 8, 1);
+        try dr.concatNorm(e, dr.normalized + slot * D * 2, e.w.embed + @as(u64, @intCast(previous)) * D * 2, c.hidden_norm, c.embed_norm);
+        // Every previous token's embedding changes the correction key, so keys are
+        // appended as proposals become known. Slot0 uses the anchor and is unsampled.
+        try linear(e, c.attention.kv_in, dr.concat, dr.ykv, 1);
+        const key = dr.correction_keys + slot * HD * 2;
+        try basic.rmsnorm(e.t, dr.ykv, HD, c.attention.kv_norm, key, HD, e.c.eps, 1, HD);
+        try norm.ropeHeads(e.t, key, e.compressed.cos, e.compressed.sin, dr.single_position, 64, false, 1, 1, HD);
+    }
+
+    fn correct(dr: *Drafter, e: *const Engine, slot: usize) !void {
+        const c = dr.w.correction;
+        const at = c.attention;
+        const pos = dr.single_position;
+        try linear(e, c.gate_proj, dr.concat, dr.cg, 1);
+        try linear(e, c.up_proj, dr.concat, dr.cu, 1);
+        try dr.k.run(e.s, "silu", .{ blocks(c.gate_proj.n), 1, 1 }, 256, .{ dr.cg, dr.cu, dr.ca, @as(i32, @intCast(c.gate_proj.n)), @as(f32, 0) });
+        try linear(e, c.down_proj, dr.ca, dr.dense_out, 1);
+        try e.ops.toF32(e.s, dr.dense_out, dr.partial, D);
+        try dr.sumPartial(e, dr.delta, 1);
+        try linear(e, at.q_in, dr.concat, dr.qa, 1);
+        try dr.normQuery(e, at.q_norm, at.wq_b, 1, pos);
+        try dr.k.run(e.s, "attention", .{ H, 1, 1 }, 256, .{ dr.q, dr.context[2], dr.valid[2], dr.kvb, at.sink, dr.o, ci(H), @as(i32, 1), @as(i32, 0) });
+        try linear(e, at.block_gate, dr.concat, dr.block_gate, 1);
+        try dr.k.run(e.s, "block_attention", .{ H, 1, 1 }, 256, .{ dr.q, dr.correction_keys, dr.block_gate, at.block_sink, at.block_rel_bias, at.block_gate_bias, dr.o, ci(H), ci(slot) });
+        try dr.output(e, at.wo_a, at.wo_b, 1, pos);
+        try dr.sumPartial(e, dr.corrected, 1);
+        try dr.k.run(e.s, "add", .{ blocks(D), 1, 1 }, 256, .{ dr.delta, dr.corrected, dr.delta, ci(D) });
+        try dr.k.run(e.s, "add", .{ blocks(D), 1, 1 }, 256, .{ dr.normalized + slot * D * 2, dr.delta, dr.corrected, ci(D) });
+    }
+
+    fn sample(dr: *Drafter, e: *const Engine, ch: *const Chunk) !i64 {
+        // The shared target head can be EXL3; only it needs the target's grouped path.
+        try e.ops.copyRows(e.s, dr.corrected, D * 2, dr.head_input, D * 2, D * 2, 1);
+        try prompt.grouped(e, ch, 1, &.{e.w.head}, &.{dr.head_input}, &.{D}, &.{dr.logits}, &.{e.w.head.n}, &.{.f32});
+        try dr.k.run(e.s, "best", .{ 1, 1, 1 }, 256, .{ dr.logits, dr.best, @as(i32, @intCast(e.w.head.n)), ci(e.w.vocab_lo) });
+        try e.gatherF32(dr.best, dr.best_all, 2);
+        try e.s.synchronize();
+        var best: [4]f32 = undefined;
+        try e.d.check(e.d.api.cuMemcpyDtoH_v2(&best, dr.best_all, @sizeOf(@TypeOf(best))), "cuMemcpyDtoH");
+        const second = best[2] > best[0] or (best[2] == best[0] and best[3] < best[1]);
+        const token = best[if (second) 3 else 1];
+        if (!std.math.isFinite(token) or token < 0 or token >= @as(f32, @floatFromInt(e.c.vocab))) return error.DFly2InvalidProposal;
+        return @intFromFloat(token);
+    }
+
+    pub fn pass(dr: *Drafter, e: *const Engine, ch: *const Chunk, view: cache.View, token: i64, q0: i64, steps: usize) !void {
+        if (steps == 0 or steps > max_drafts or q0 < 1 or token < 0 or token >= e.c.vocab) return error.BadDraftPass;
+        if (view.position + 1 != @as(usize, @intCast(q0))) return error.DFly2StaleAnchor;
+        var ids: [R]i64 = @splat(mask_token);
+        ids[0] = token;
+        var positions: [R]i64 = undefined;
+        for (0..R) |i| positions[i] = q0 + @as(i64, @intCast(i));
+        try prompt.upload(e, dr.ids, &ids, @sizeOf(@TypeOf(ids)));
+        try prompt.upload(e, dr.positions, &positions, @sizeOf(@TypeOf(positions)));
+        for (view.stages, 0..) |v, j| {
+            try dr.k.run(e.s, "gather_context", .{ 640, 1, 1 }, 256, .{ v.codes, v.scales, v.indices, v.ring, dr.context[j], dr.valid[j], @as(i64, @intCast(v.compressed_base)), @as(i64, @intCast(v.ring_base)), ci(v.ring_rows), @as(i64, @intCast(v.anchor_position)), @as(i64, @intCast(v.window_start)) });
+        }
+        try dr.concatNorm(e, e.w.embed + @as(u64, @intCast(token)) * D * 2, view.hidden, dr.w.mtp.enorm, dr.w.mtp.hnorm);
+        try linear(e, dr.w.mtp.eh_proj, dr.concat, dr.fusion, 1);
+        try dr.k.run(e.s, "init_block", .{ R, 1, 1 }, 256, .{ e.w.embed, dr.ids, dr.fusion, dr.w.mtp.gate, dr.h, dr.pre, ci(D), ci(R) });
+        var h = dr.h;
+        var spare = dr.h_alt;
+        var pre = dr.pre;
+        var next_pre = dr.pre_f;
+        var pending = false;
+        for (0..3) |j| {
+            const l = dr.w.layers[j].attn;
+            h = try dr.mixes(e, h, &spare, &pending, l.hc_attn, pre, l.attn_norm, dr.pre_a);
+            try dr.attend(e, j);
+            try dr.gatherPartial(e, R);
+            pending = true;
+            h = try dr.mixes(e, h, &spare, &pending, l.hc_ffn, dr.pre_a, l.ffn_norm, next_pre);
+            try dr.moe(e, j);
+            try dr.gatherPartial(e, R);
+            pending = true;
+            std.mem.swap(u64, &pre, &next_pre);
+        }
+        try basic.hcPost(e.t, dr.gathered, h, dr.post, dr.comb, h, 2, R, D);
+        try basic.collapse(e.t, h, pre, dr.collapsed, R, D);
+        try basic.rmsnorm(e.t, dr.collapsed, D, dr.w.final_norm, dr.normalized, D, e.c.eps, R, D);
+        try dr.correctionInput(e, 0, token);
+        var previous = token;
+        for (1..steps + 1) |slot| {
+            try dr.correctionInput(e, slot, previous);
+            try dr.correct(e, slot);
+            previous = try dr.sample(e, ch);
+            dr.drafts[0][slot - 1] = previous;
+        }
+        dr.streams = 1;
+        dr.steps = steps;
+    }
+};
diff --git a/zig/src/families/dsv41/dfly_cache.zig b/zig/src/families/dsv41/dfly_cache.zig
new file mode 100644
index 000000000..8e99ac47a
--- /dev/null
+++ b/zig/src/families/dsv41/dfly_cache.zig
@@ -0,0 +1,552 @@
+//! Optional DFly2 target snapshots. Only indices and final normalized hidden states
+//! are copied; target FP4 compressed KV and BF16 near-window rings remain borrowed.
+//! Attach to Engine before a forward. Reset a slot on reuse, restore, or extent
+//! relocation. Before prompt/replay call beginPrompt; round.forward begins its own
+//! transaction. After success retain(e, slot, q0) selects the target row q0 - 1
+//! which predicted the pending token at q0. No tree or early-exit target execution.
+//!
+//! GPU copies use the engine stream, including graph capture/replay. The host
+//! transaction is begun/finished outside graphs. A failed/partial forward cannot
+//! expose snapshots. Keep this object and its device addresses alive until graphs
+//! using graphKey() are destroyed. Never mutate target caches while a View is used.
+const std = @import("std");
+
+pub const layers = [_]usize{ 28, 32, 36 };
+pub const source_layer: usize = 20;
+pub const top_k: usize = 512;
+
+pub const StageView = struct {
+    codes: u64,
+    scales: u64,
+    indices: u64, // int64 [512], padded with -1, sequence-relative ids
+    compressed_base: usize, // row offset into codes/scales, ratio 1
+    ring: u64, // bf16 [slots * ring_rows, head_dim]
+    ring_rows: usize,
+    ring_base: usize, // row offset of this slot in ring
+    anchor_position: usize, // q0 - 1 (the row whose hidden predicted the pending token)
+    window_start: usize, // inclusive; honor this floor after bounded replay
+};
+
+pub const View = struct {
+    hidden: u64, // bf16 [hidden_size], after target collapseNorm
+    position: usize,
+    stages: [layers.len]StageView,
+};
+
+/// Full-pool pointers for a round; a prompt hook records its already-offset views.
+pub const Borrowed = struct {
+    codes: u64,
+    scales: u64,
+    rings: [layers.len]u64,
+};
+
+const Row = struct {
+    slot: usize = 0,
+    pos: usize = 0,
+    base: usize = 0,
+    ring_base: usize = 0,
+    floor: usize = 0,
+    borrowed: Borrowed = .{ .codes = 0, .scales = 0, .rings = @splat(0) },
+};
+
+const Slot = struct {
+    retained: ?Row = null,
+    // Retain the high-water mark even when a suffix is rejected. Those writes
+    // still occupy the modulo ring until overwritten or the slot is reset.
+    highest: ?usize = null,
+    floor: usize = 0,
+};
+
+pub const Capture = struct {
+    gpa: std.mem.Allocator,
+    rows: []Row,
+    slots: []Slot,
+    n: usize = 0,
+    mode: enum { idle, prompt, round } = .idle,
+    ready: bool = false,
+    hidden_size: usize,
+    head_dim: usize,
+    window: usize,
+    extra: usize,
+    indices: u64 = 0, // [3, row_cap, 512] i64
+    hidden: u64 = 0, // [row_cap, hidden_size] bf16
+    kept_indices: u64 = 0, // [slots, 3, 512] i64
+    kept_hidden: u64 = 0, // [slots, hidden_size] bf16
+    prompt_seen: u8 = 0,
+
+    pub fn init(gpa: std.mem.Allocator, arena: anytype, streams: usize, row_cap: usize, hidden_size: usize, head_dim: usize, window: usize, extra: usize) !Capture {
+        if (streams == 0 or row_cap == 0 or hidden_size == 0 or head_dim == 0 or window == 0 or extra == 0) return error.BadDflyCaptureShape;
+        const rows = try gpa.alloc(Row, row_cap);
+        errdefer gpa.free(rows);
+        const slots = try gpa.alloc(Slot, streams);
+        errdefer gpa.free(slots);
+        @memset(rows, .{});
+        @memset(slots, .{});
+        return .{
+            .gpa = gpa,
+            .rows = rows,
+            .slots = slots,
+            .hidden_size = hidden_size,
+            .head_dim = head_dim,
+            .window = window,
+            .extra = extra,
+            .indices = try arena.take(layers.len * row_cap * top_k * 8),
+            .hidden = try arena.take(row_cap * hidden_size * 2),
+            .kept_indices = try arena.take(streams * layers.len * top_k * 8),
+            .kept_hidden = try arena.take(streams * hidden_size * 2),
+        };
+    }
+
+    /// Device allocations belong to the caller's arena.
+    pub fn deinit(c: *Capture) void {
+        c.gpa.free(c.rows);
+        c.gpa.free(c.slots);
+        c.* = undefined;
+    }
+
+    pub fn graphKey(c: *const Capture) u64 {
+        return c.indices;
+    }
+
+    /// This first integration supports replicated TP2 KV, not ownership-sharded
+    /// or four-rank layouts. Refuse different shapes before any target writes.
+    pub fn checkTarget(c: *const Capture, e: anytype) !void {
+        if (e.world != 2 or e.two != null or e.kv != null) return error.UnsupportedDflyKvLayout;
+        if (e.c.hidden != c.hidden_size or e.c.head_dim != c.head_dim or e.c.window != c.window or e.c.index_topk != top_k or e.w.layers.len != 40) return error.BadDflyCaptureShape;
+        var source: ?usize = null;
+        for (e.w.layers, 0..) |layer, i| {
+            if (layer.comp_wkv != null) source = i;
+            if (stageOf(i) != null and (source != source_layer or layer.ratio != 1 or layer.idx_wq_b == null)) return error.UnsupportedDflyKvLayout;
+        }
+    }
+
+    pub fn reset(c: *Capture, slot: usize) !void {
+        if (slot >= c.slots.len) return error.BadDflySlot;
+        c.slots[slot] = .{};
+        // Staged rows are a transaction, not independently reusable snapshots.
+        for (c.rows[0..c.n]) |row| if (row.slot == slot) {
+            c.ready = false;
+            break;
+        };
+    }
+
+    pub fn abort(c: *Capture) void {
+        c.ready = false;
+        c.mode = .idle;
+    }
+
+    /// Called once before a prompt chunk, including bounded replay. Its final
+    /// position is invariant when replayCut trims rows from the front. Only that
+    /// last row is retained, so chunk size does not affect snapshot allocation.
+    pub fn beginPrompt(c: *Capture, slot: usize, start: usize, n: usize, floor: usize) !void {
+        if (slot >= c.slots.len) return error.BadDflySlot;
+        // floor may lie inside or beyond an encoder chunk; replayCut either
+        // trims its front or returns before these anchor layers and the head.
+        if (n == 0 or start > std.math.maxInt(usize) - n) return error.BadDflyRows;
+        const pos = start + n - 1;
+        c.ready = false;
+        c.mode = .prompt;
+        c.n = 1;
+        c.prompt_seen = 0;
+        c.rows[0] = .{ .slot = slot, .pos = pos, .floor = floor };
+        var s = &c.slots[slot];
+        s.retained = null;
+        s.floor = floor;
+        s.highest = if (s.highest) |h| @max(h, pos) else pos;
+    }
+
+    /// A ring of window+extra rows still contains every possible accepted row's
+    /// window only when the stream's verify span is <=extra+1. Reject malformed
+    /// or wider windows BEFORE target writes. Native B6 needs only six rows.
+    pub fn beginRound(c: *Capture, input: anytype, borrowed: Borrowed) !void {
+        const n = input.pos.len;
+        if (n == 0 or n > c.rows.len or input.ids.len != n) return error.BadDflyRows;
+        if (input.slots) |v| if (v.len != n) return error.BadDflyRows;
+        if (input.bases) |v| if (v.len != n) return error.BadDflyRows;
+        if (input.ends) |v| if (v.len != n) return error.BadDflyRows;
+        if (borrowed.codes == 0 or borrowed.scales == 0) return error.NoDflyKv;
+        for (borrowed.rings) |p| if (p == 0) return error.NoDflyKv;
+        // Validate without changing an existing ready/retained transaction.
+        for (input.pos, 0..) |p, i| {
+            const slot_i = if (input.slots) |v| v[i] else 0;
+            const base_i = if (input.bases) |v| v[i] else input.base;
+            const end_i = if (input.ends) |v| v[i] else input.end;
+            if (p < 0 or slot_i < 0 or base_i < 0 or end_i < 0) return error.BadDflyRows;
+            const slot: usize = @intCast(slot_i);
+            const pos: usize = @intCast(p);
+            if (slot >= c.slots.len) return error.BadDflySlot;
+            if (end_i > 0 and (end_i <= base_i or p >= end_i - base_i)) return error.BadDflyRows;
+            if (pos == std.math.maxInt(usize) or pos < c.slots[slot].floor) return error.BadDflyRows;
+            var first = pos;
+            var prev: ?usize = null;
+            for (input.pos[0..i], 0..) |q, j| {
+                const other = if (input.slots) |v| v[j] else 0;
+                if (other != slot_i) continue;
+                const other_base = if (input.bases) |v| v[j] else input.base;
+                if (other_base != base_i) return error.BadDflyRows;
+                first = @min(first, @as(usize, @intCast(q)));
+                prev = @intCast(q);
+            }
+            if (prev) |q| if (pos != q + 1) return error.BadDflyRows;
+            if (pos - first > c.extra) return error.DflyWindowWouldOverwrite;
+            const newest = if (c.slots[slot].highest) |h| @max(h, pos) else pos;
+            try c.checkWindow(first, newest, c.slots[slot].floor);
+        }
+        c.ready = false;
+        c.mode = .round;
+        c.n = n;
+        for (input.pos, 0..) |p, i| {
+            const slot: usize = @intCast(if (input.slots) |v| v[i] else 0);
+            const base: usize = @intCast(if (input.bases) |v| v[i] else input.base);
+            const pos: usize = @intCast(p);
+            var s = &c.slots[slot];
+            c.rows[i] = .{ .slot = slot, .pos = pos, .base = base, .ring_base = slot * (c.window + c.extra), .floor = s.floor, .borrowed = borrowed };
+            s.retained = null;
+            s.highest = if (s.highest) |h| @max(h, pos) else pos;
+        }
+    }
+
+    fn checkWindow(c: *const Capture, anchor: usize, newest: usize, floor: usize) !void {
+        const first = @max(floor, anchor -| (c.window - 1));
+        if (newest < anchor or newest - first >= c.window + c.extra) return error.DflyWindowOverwritten;
+    }
+
+    /// Called by the target index-source layer after selection, before cidx is
+    /// reused. Only GPU work: this function may run during CUDA graph capture.
+    pub fn captureRound(c: *Capture, e: anytype, layer: usize, src: u64, k: usize, n: usize) !void {
+        const stage = stageOf(layer) orelse return;
+        if (c.mode != .round or c.n != n or k > top_k) return error.BadDflyCapture;
+        const dst = c.indices + stage * c.rows.len * top_k * 8;
+        try padAndCopy(e, dst, src, k, n);
+    }
+
+    pub fn capturePrompt(c: *Capture, e: anytype, layer: usize, start: usize, n: usize, src: u64, k: usize, codes: u64, scales: u64, ring: u64) !void {
+        const stage = stageOf(layer) orelse return;
+        if (c.mode != .prompt or c.n != 1 or n == 0 or start + n - 1 != c.rows[0].pos or c.rows[0].floor > c.rows[0].pos or k > top_k) return error.BadDflyCapture;
+        if (codes == 0 or scales == 0 or ring == 0) return error.NoDflyKv;
+        const dst = c.indices + stage * c.rows.len * top_k * 8;
+        try padAndCopy(e, dst, src + (n - 1) * k * 8, k, 1);
+        c.rows[0].borrowed.codes = codes;
+        c.rows[0].borrowed.scales = scales;
+        c.rows[0].borrowed.rings[stage] = ring;
+        c.prompt_seen |= @as(u8, 1) << @intCast(stage);
+    }
+
+    pub fn captureHidden(c: *Capture, e: anytype, src: u64, n: usize) !void {
+        if (c.n != n or c.mode == .idle) return error.BadDflyCapture;
+        const width = c.hidden_size * 2;
+        try e.ops.copyRows(e.s, src, width, c.hidden, width, width, n);
+    }
+
+    /// Host-side only: round.forward calls this AFTER successful graph replay;
+    /// prompt.head after capturing its last-row final normalized hidden state.
+    pub fn finish(c: *Capture) !void {
+        if (c.mode == .idle or c.n == 0) return error.BadDflyCapture;
+        if (c.mode == .prompt and c.prompt_seen != 0b111) return error.IncompleteDflyCapture;
+        c.ready = true;
+    }
+
+    const Choice = union(enum) { staged: usize, retained };
+
+    /// A host-only resume/restore check; unlike retain, this queues no GPU copy.
+    pub fn checkAnchor(c: *const Capture, slot: usize, q0: usize) !void {
+        _ = try c.choose(slot, q0);
+    }
+
+    fn choose(c: *const Capture, slot: usize, q0: usize) !Choice {
+        if (slot >= c.slots.len) return error.BadDflySlot;
+        if (q0 == 0) return error.NoDflyAnchor;
+        const pos = q0 - 1;
+        const s = c.slots[slot];
+        const newest = s.highest orelse return error.NoDflyAnchor;
+        if (pos > newest) return error.NoDflyAnchor;
+        try c.checkWindow(pos, newest, s.floor);
+        if (s.retained) |row| if (row.pos == pos) return .retained;
+        if (c.ready) for (c.rows[0..c.n], 0..) |row, i| {
+            if (row.slot == slot and row.pos == pos) return .{ .staged = i };
+        };
+        return error.NoDflyAnchor;
+    }
+
+    /// Keep exactly the accepted predecessor of the pending token. Persistent
+    /// indices/hidden survive other slots' rounds; borrowed KV is valid only until
+    /// the next write/reset/restore of this slot. Same-stream ordering suffices.
+    pub fn retain(c: *Capture, e: anytype, slot: usize, q0: usize) !View {
+        switch (try c.choose(slot, q0)) {
+            .retained => {},
+            .staged => |row| {
+                for (0..layers.len) |stage| {
+                    const src = c.indices + (stage * c.rows.len + row) * top_k * 8;
+                    const dst = c.kept_indices + (slot * layers.len + stage) * top_k * 8;
+                    try e.ops.copyRows(e.s, src, top_k * 8, dst, top_k * 8, top_k * 8, 1);
+                }
+                const width = c.hidden_size * 2;
+                try e.ops.copyRows(e.s, c.hidden + row * width, width, c.kept_hidden + slot * width, width, width, 1);
+                c.slots[slot].retained = c.rows[row];
+            },
+        }
+        return c.view(slot, q0);
+    }
+
+    pub fn view(c: *const Capture, slot: usize, q0: usize) !View {
+        if (slot >= c.slots.len) return error.BadDflySlot;
+        const s = c.slots[slot];
+        const row = s.retained orelse return error.NoDflyAnchor;
+        if (q0 == 0 or row.pos != q0 - 1) return error.NoDflyAnchor;
+        try c.checkWindow(row.pos, s.highest orelse return error.NoDflyAnchor, row.floor);
+        var out: View = .{ .hidden = c.kept_hidden + slot * c.hidden_size * 2, .position = row.pos, .stages = undefined };
+        for (0..layers.len) |stage| out.stages[stage] = .{
+            .codes = row.borrowed.codes,
+            .scales = row.borrowed.scales,
+            .indices = c.kept_indices + (slot * layers.len + stage) * top_k * 8,
+            .compressed_base = row.base,
+            .ring = row.borrowed.rings[stage],
+            .ring_rows = c.window + c.extra,
+            .ring_base = row.ring_base,
+            .anchor_position = row.pos,
+            .window_start = @max(row.floor, row.pos -| (c.window - 1)),
+        };
+        return out;
+    }
+};
+
+pub fn stageOf(layer: usize) ?usize {
+    for (layers, 0..) |l, i| if (l == layer) return i;
+    return null;
+}
+
+fn padAndCopy(e: anytype, dst: u64, src: u64, k: usize, n: usize) !void {
+    // Always use the fixed 512 stride, including contexts shorter than top-k.
+    if (k < top_k) try e.d.check(e.d.api.cuMemsetD8Async(dst, 0xff, n * top_k * 8, e.s.handle), "cuMemsetD8Async");
+    if (k > 0) try e.ops.copyRows(e.s, src, k * 8, dst, top_k * 8, k * 8, n);
+}
+
+// CPU-only lifecycle tests: fake arena addresses, no CUDA import or GPU needed.
