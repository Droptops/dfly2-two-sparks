new file mode 100644
index 000000000..336dcb5e4
--- /dev/null
+++ b/zig/src/families/dsv41/dfly_weights_main.zig
@@ -0,0 +1,37 @@
+//! Standalone DFly2 pack/hash/shape/upload check, without loading the target.
+//! tf-dsv41-dfly-weights PACKED_DIR RANK [TARGET_MODEL_DIR]
+const std = @import("std");
+const cuda = @import("cuda");
+const dsv41 = @import("dsv41");
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len < 3 or args.len > 4) {
+        std.debug.print("usage: tf-dsv41-dfly-weights PACKED_DIR RANK [TARGET_MODEL_DIR]\n", .{});
+        return 2;
+    }
+    const rank = try std.fmt.parseInt(u32, args[2], 10);
+    if (rank > 1) return error.DFlyNeedsTP2;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var context = try cuda.Context.init(&driver, 0);
+    defer context.deinit();
+    const before = cuda.usage(false).device;
+    var w = try dsv41.dfly_weights.Weights.load(init.gpa, init.io, &driver, args[1], rank);
+    var alive = true;
+    defer if (alive) w.deinit();
+    if (args.len == 4) {
+        const target = try dsv41.Config.read(init.gpa, init.io, args[3]);
+        try w.config.checkTarget(target);
+    }
+    try w.verifyUploads(init.io, &driver, args[1]);
+    try context.synchronize();
+    const count = w.named.items.len;
+    const bytes = w.bytes;
+    const identity = w.identity;
+    w.deinit();
+    alive = false;
+    if (cuda.usage(false).device != before) return error.DFlyAllocationLeak;
+    std.debug.print("{{\"ok\":true,\"rank\":{d},\"sm\":{d},\"tensors\":{d},\"device_bytes\":{d},\"identity\":\"{x}\",\"all_uploaded_bytes_equal\":true,\"allocation_released\":true}}\n", .{ rank, try context.capability(), count, bytes, &identity });
+    return 0;
+}
