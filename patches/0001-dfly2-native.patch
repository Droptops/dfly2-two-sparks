+    rope_factor: f64 = 16,
+    beta_fast: f64 = 32,
+    beta_slow: f64 = 1,
+
+    pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Config {
+        const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(path);
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20));
+        defer gpa.free(bytes);
+        return parse(gpa, bytes);
+    }
+
+    pub fn parse(gpa: std.mem.Allocator, bytes: []const u8) !Config {
+        const parsed = try std.json.parseFromSlice(std.json.Value, gpa, bytes, .{});
+        defer parsed.deinit();
+        const root = try object(parsed.value);
+        const arch = root.get("architectures") orelse return error.BadDFlyConfig;
+        if (arch != .array or arch.array.items.len != 1) return error.BadDFlyConfig;
+        try stringIs(arch.array.items[0], "DFlyDeepseekV41DraftModel");
+        const t = try object(root.get("text_config") orelse return error.BadDFlyConfig);
+        inline for (.{
+            .{ "hidden_size", 5120 },       .{ "vocab_size", 129280 },    .{ "num_hidden_layers", 40 },
+            .{ "num_attention_heads", 64 }, .{ "head_dim", 512 },         .{ "qk_rope_head_dim", 64 },
+            .{ "q_lora_rank", 1280 },       .{ "o_lora_rank", 1024 },     .{ "o_groups", 8 },
+            .{ "sliding_window", 128 },     .{ "index_topk", 512 },       .{ "moe_intermediate_size", 2304 },
+            .{ "hc_mult", 4 },              .{ "hc_sinkhorn_iters", 20 }, .{ "n_shared_experts", 1 },
+        }) |entry| try numberIs(t, entry[0], entry[1]);
+        try numberIs(t, "hc_eps", 1e-6);
+        try numberIs(t, "rms_norm_eps", 1e-20);
+        try numberIs(t, "routed_scaling_factor", 1.5);
+        try numberIs(t, "swiglu_limit", 10.0);
+        try stringIs(t.get("scoring_func") orelse return error.BadDFlyConfig, "sqrtsoftplus");
+        try boolIs(t, "norm_topk_prob", true);
+        const d = try object(root.get("dfly_config") orelse return error.BadDFlyConfig);
+        try numberIs(d, "block_size", 6);
+        try numberIs(d, "index_topk", 512);
+        try numberIs(d, "mask_token_id", 128799);
+        try boolIs(d, "causal_block", false);
+        try stringIs(d.get("mtp_fusion") orelse return error.BadDFlyConfig, "slot0");
+        try stringIs(d.get("dense_dtype") orelse return error.BadDFlyConfig, "bfloat16");
+        inline for (.{ "target_kv_layers", "target_index_layers" }) |key| {
+            const ids = d.get(key) orelse return error.BadDFlyConfig;
+            if (ids != .array or ids.array.items.len != 3) return error.BadDFlyConfig;
+            for (ids.array.items, [_]i64{ 28, 32, 36 }) |v, want| {
+                if (v != .integer or v.integer != want) return error.BadDFlyConfig;
+            }
+        }
+        const h = try object(d.get("hidden_correction") orelse return error.BadDFlyConfig);
+        try numberIs(h, "intermediate_size", 5120);
+        const a = try object(d.get("attentive_correction") orelse return error.BadDFlyConfig);
+        try numberIs(a, "source_layer", -1);
+        try numberIs(a, "max_block_slots", 16);
+        try boolIs(a, "block_keys", true);
+        try stringIs(a.get("block_mode") orelse return error.BadDFlyConfig, "gated");
+        try stringIs(a.get("block_kv_in") orelse return error.BadDFlyConfig, "hidden_embed");
+        const r = try object(d.get("rope") orelse return error.BadDFlyConfig);
+        try numberIs(r, "theta", 160000);
+        try numberIs(r, "original_seq_len", 65536);
+        try numberIs(r, "factor", 16);
+        try numberIs(r, "beta_fast", 32);
+        try numberIs(r, "beta_slow", 1);
+        return .{};
+    }
+
+    /// Geometry/layout agreement is necessary; it is not a claim that 1017's
+    /// target activations match the target used to train the released drafter.
+    pub fn checkTarget(c: Config, t: Target) !void {
+        if (t.layers != 40 or t.hidden != c.hidden or t.vocab != c.vocab or t.heads != c.heads or
+            t.head_dim != c.head_dim or t.rope_dim != c.rope_dim or t.q_lora != c.q_lora or
+            t.o_lora != c.o_lora or t.o_groups != c.o_groups or t.window != c.window or
+            t.index_topk != c.index_topk or t.hc != c.hc or t.candidate_source != 20 or
+            t.compress_rope_theta != c.rope_theta or t.rope_factor != c.rope_factor or
+            t.original_max_position != c.original_seq_len or t.beta_fast != c.beta_fast or
+            t.beta_slow != c.beta_slow) return error.DFlyTargetMismatch;
+        if (!t.kv_sources.has(20)) return error.DFlyTargetMismatch;
+        for (c.anchors) |layer| {
+            if (!t.index_sources.has(layer) or t.ratios[layer] != 1) return error.DFlyTargetMismatch;
+            var source: usize = 0;
+            for (t.kv_sources.slice()) |id| if (id <= layer) {
+                source = id;
+            };
+            if (source != 20) return error.DFlyTargetMismatch;
+        }
+    }
+};
+
+fn object(v: std.json.Value) !std.json.ObjectMap {
+    return if (v == .object) v.object else error.BadDFlyConfig;
+}
+
+fn stringIs(v: std.json.Value, want: []const u8) !void {
+    if (v != .string or !std.mem.eql(u8, v.string, want)) return error.BadDFlyConfig;
+}
+
+fn numberIs(o: std.json.ObjectMap, key: []const u8, want: f64) !void {
+    const v = o.get(key) orelse return error.BadDFlyConfig;
+    const value: f64 = switch (v) {
+        .integer => |x| @floatFromInt(x),
+        .float => |x| x,
+        else => return error.BadDFlyConfig,
+    };
+    if (value != want) return error.BadDFlyConfig;
+}
+
+fn boolIs(o: std.json.ObjectMap, key: []const u8, want: bool) !void {
+    const v = o.get(key) orelse return error.BadDFlyConfig;
+    if (v != .bool or v.bool != want) return error.BadDFlyConfig;
+}
+
+test "DFly2 never inherits target expert counts" {
+    const c: Config = .{};
+    try std.testing.expectEqual(@as(usize, 128), c.experts);
+    try std.testing.expectEqual(@as(usize, 3), c.top_k);
+    try std.testing.expectEqual(@as(usize, 6), c.block);
+}
+
+test "DFly2 rejects malformed architecture before reading target fields" {
+    try std.testing.expectError(error.BadDFlyConfig, Config.parse(std.testing.allocator, "{\"architectures\":[\"DSparkDraftModel\"]}"));
+}
diff --git a/zig/src/families/dsv41/dfly_kernels.zig b/zig/src/families/dsv41/dfly_kernels.zig
new file mode 100644
index 000000000..f799dfd1f
--- /dev/null
+++ b/zig/src/families/dsv41/dfly_kernels.zig
@@ -0,0 +1,43 @@
+//! DFly2-only kernels. The target decoder and its existing DSpark kernels are untouched.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Kernels = struct {
+    module: cuda.Module,
+    norm_concat: cuda.Function,
+    init_block: cuda.Function,
+    add: cuda.Function,
+    silu: cuda.Function,
+    route: cuda.Function,
+    fp4: cuda.Function,
+    mix_experts: cuda.Function,
+    gather_context: cuda.Function,
+    attention: cuda.Function,
+    block_attention: cuda.Function,
+    best: cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        var m = try cuda.Module.load(d, cuda.kernels.dsv41_dfly2);
+        errdefer m.unload();
+        var out: Kernels = undefined;
+        out.module = m;
+        inline for (@typeInfo(Kernels).@"struct".field_names) |name| {
+            if (comptime !std.mem.eql(u8, name, "module"))
+                @field(out, name) = try m.function("tf_dfly_" ++ name);
+        }
+        return out;
+    }
+
+    pub fn deinit(k: *Kernels) void {
+        k.module.unload();
+    }
+
+    pub fn run(k: *const Kernels, s: cuda.Stream, comptime name: []const u8, grid: [3]usize, threads: u32, args: anytype) !void {
+        var a: cuda.Args = .{};
+        inline for (args) |arg| a.add(arg);
+        try cuda.launch.launch(@field(k, name), .{
+            .grid = .{ .x = @intCast(grid[0]), .y = @intCast(grid[1]), .z = @intCast(grid[2]) },
+            .block = .{ .x = threads },
+        }, s, &a);
+    }
+};
diff --git a/zig/src/families/dsv41/dfly_weights.zig b/zig/src/families/dsv41/dfly_weights.zig
new file mode 100644
index 000000000..80083d696
--- /dev/null
+++ b/zig/src/families/dsv41/dfly_weights.zig
@@ -0,0 +1,269 @@
+//! DFly2's independent MXFP4/BF16 checkpoint, byte-preserving TP2 partition.
+//! tools/dfly2/pack_weights.py checks the released schema and produces rankN.
+//! This loader refuses the DSpark layout; target embedding/head remain borrowed.
+const std = @import("std");
+const cuda = @import("cuda");
+const st = @import("core").safetensors;
+const weights = @import("weights.zig");
+const cfg = @import("dfly_config.zig");
+pub const Linear = weights.Linear;
+
+pub const Mxfp4Experts = struct {
+    codes: u64, // [count,n,k/2] bytes, two E2M1 nibbles, low nibble first
+    scales: u64, // [count,n,k/32] raw E8M0 exponents, 127 means one
+    count: u32,
+    n: u32,
+    k: u32,
+};
+
+pub const Layer = struct {
+    // gate_w is BF16 here, unlike the EXL3 target loader's FP16 router.
+    // experts in this struct is deliberately unused: use w1/w2/w3 below.
+    attn: weights.Layer,
+    w1: Mxfp4Experts,
+    w2: Mxfp4Experts,
+    w3: Mxfp4Experts,
+    shared_w1: Linear,
+    shared_w2: Linear,
+    shared_w3: Linear,
+};
+
+pub const Fusion = struct { eh_proj: Linear, enorm: u64, hnorm: u64, gate: u64 };
+pub const CorrectionAttention = struct {
+    q_in: Linear,
+    q_norm: u64,
+    wq_b: Linear,
+    sink: u64,
+    wo_a: [4]Linear,
+    wo_b: Linear,
+    kv_in: Linear,
+    kv_norm: u64,
+    block_gate: Linear,
+    block_gate_bias: u64, // F32 [32,16]
+    block_rel_bias: u64, // F32 [32,16]
+    block_sink: u64, // F32 [32]
+};
+pub const Correction = struct {
+    gate_proj: Linear, // [2560,10240], rank's intermediate half
+    up_proj: Linear,
+    down_proj: Linear, // [5120,2560], TP sum after applying this projection
+    hidden_norm: u64,
+    embed_norm: u64,
+    attention: CorrectionAttention,
+};
+
+pub const Weights = struct {
+    gpa: std.mem.Allocator,
+    config: cfg.Config,
+    identity: [32]u8, // same manifest digest on both ranks
+    rank: u32,
+    layers: [3]Layer = undefined,
+    final_norm: u64 = 0,
+    mtp: Fusion = undefined,
+    correction: Correction = undefined,
+    buffers: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    named: std.ArrayList(weights.Named) = .empty,
+    bytes: u64 = 0,
+
+    pub fn deinit(w: *Weights) void {
+        for (w.buffers.items) |*buffer| buffer.free();
+        for (w.named.items) |entry| w.gpa.free(entry.name);
+        w.buffers.deinit(w.gpa);
+        w.named.deinit(w.gpa);
+        w.* = undefined;
+    }
+
+    /// An explicit installation check, not serving overhead: compare every
+    /// uploaded byte with the packed checkpoint in bounded 4 MiB pieces.
+    pub fn verifyUploads(w: *const Weights, io: std.Io, driver: *const cuda.Driver, dir: []const u8) !void {
+        const path = try std.fmt.allocPrint(w.gpa, "{s}/rank{d}.safetensors", .{ dir, w.rank });
+        defer w.gpa.free(path);
+        var file = try st.File.open(w.gpa, io, path);
+        defer file.close(io);
+        const host = try w.gpa.alloc(u8, 4 << 20);
+        defer w.gpa.free(host);
+        for (w.named.items) |entry| {
+            const t = file.get(entry.name) orelse return error.MissingDFlyTensor;
+            if (t.bytes.len != entry.len) return error.BadDFlyTensor;
+            var at: usize = 0;
+            while (at < entry.len) {
+                const n = @min(host.len, entry.len - at);
+                try driver.check(driver.api.cuMemcpyDtoH_v2(host.ptr, entry.ptr + at, n), "DFly2 upload verification");
+                if (!std.mem.eql(u8, host[0..n], t.bytes[at..][0..n])) {
+                    std.log.err("DFly2 upload bytes differ: {s} at offset {d}", .{ entry.name, at });
+                    return error.DFlyUploadMismatch;
+                }
+                at += n;
+            }
+        }
+    }
+
+    pub fn load(gpa: std.mem.Allocator, io: std.Io, driver: *const cuda.Driver, dir: []const u8, rank: u32) !Weights {
+        if (rank > 1) return error.DFlyNeedsTP2;
+        const config = try cfg.Config.read(gpa, io, dir);
+        const path = try std.fmt.allocPrint(gpa, "{s}/rank{d}.safetensors", .{ dir, rank });
+        defer gpa.free(path);
+        var file = try st.File.open(gpa, io, path);
+        defer file.close(io);
+        const identity = try manifestIdentity(gpa, io, dir, rank, &file);
+        // 88 ordinary tensors and 18 expert stacks, including all correction tensors.
+        if (file.names.count() != 106) return error.DFlyTensorCount;
+        var w: Weights = .{ .gpa = gpa, .config = config, .identity = identity, .rank = rank };
+        errdefer w.deinit();
+        var loader: Loader = .{ .w = &w, .d = driver, .file = &file };
+        w.final_norm = try loader.tensor("model.final_norm.weight", .bf16, &.{5120});
+        w.mtp = .{
+            .eh_proj = try loader.linear("model.mtp_fusion.eh_proj.weight", 5120, 10240),
+            .enorm = try loader.tensor("model.mtp_fusion.enorm.weight", .bf16, &.{5120}),
+            .hnorm = try loader.tensor("model.mtp_fusion.hnorm.weight", .bf16, &.{5120}),
+            .gate = try loader.tensor("model.mtp_fusion.gate", .bf16, &.{5120}),
+        };
+        w.correction = .{
+            .gate_proj = try loader.linear("model.hidden_correction.gate_proj.weight", 2560, 10240),
+            .up_proj = try loader.linear("model.hidden_correction.up_proj.weight", 2560, 10240),
+            .down_proj = try loader.linear("model.hidden_correction.down_proj.weight", 5120, 2560),
+            .hidden_norm = try loader.tensor("model.hidden_correction.hidden_norm.weight", .bf16, &.{5120}),
+            .embed_norm = try loader.tensor("model.hidden_correction.embed_norm.weight", .bf16, &.{5120}),
+            .attention = undefined,
+        };
+        const p = "model.hidden_correction.attention";
+        var ca: CorrectionAttention = .{
+            .q_in = try loader.linear(p ++ ".q_in.weight", 1280, 10240),
+            .q_norm = try loader.tensor(p ++ ".q_norm.weight", .bf16, &.{1280}),
+            .wq_b = try loader.linear(p ++ ".wq_b.weight", 16384, 1280),
+            .sink = try loader.tensor(p ++ ".attn_sink", .f32, &.{32}),
+            .wo_a = undefined,
+            .wo_b = try loader.linear(p ++ ".wo_b.weight", 5120, 4096),
+            .kv_in = try loader.linear(p ++ ".kv_in.weight", 512, 10240),
+            .kv_norm = try loader.tensor(p ++ ".kv_norm.weight", .bf16, &.{512}),
+            .block_gate = try loader.linear(p ++ ".block_gate.weight", 32, 10240),
+            .block_gate_bias = try loader.tensor(p ++ ".block_gate_bias", .f32, &.{ 32, 16 }),
+            .block_rel_bias = try loader.tensor(p ++ ".block_rel_bias", .f32, &.{ 32, 16 }),
+            .block_sink = try loader.tensor(p ++ ".block_sink", .f32, &.{32}),
+        };
+        ca.wo_a = try loader.grouped(p ++ ".wo_a.weight");
+        w.correction.attention = ca;
+        for (&w.layers, 0..) |*layer, i| layer.* = try loader.layer(i);
+        return w;
+    }
+};
+
+fn manifestIdentity(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, rank: u32, file: *const st.File) ![32]u8 {
+    const path = try std.fs.path.join(gpa, &.{ dir, "dfly2-pack.json" });
+    defer gpa.free(path);
+    const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20));
+    defer gpa.free(bytes);
+    const parsed = try std.json.parseFromSlice(std.json.Value, gpa, bytes, .{});
+    defer parsed.deinit();
+    if (parsed.value != .object) return error.BadDFlyPack;
+    const o = parsed.value.object;
+    const format = o.get("format") orelse return error.BadDFlyPack;
+    const world = o.get("world_size") orelse return error.BadDFlyPack;
+    const ranks = o.get("ranks") orelse return error.BadDFlyPack;
+    if (format != .string or !std.mem.eql(u8, format.string, cfg.format) or
+        world != .integer or world.integer != 2 or ranks != .array or ranks.array.items.len != 2) return error.BadDFlyPack;
+    // The manifest's common hash alone cannot detect rank-file swaps/corruption.
+    const record = ranks.array.items[rank];
+    if (record != .object) return error.BadDFlyPack;
+    const name = record.object.get("file") orelse return error.BadDFlyPack;
+    const size = record.object.get("bytes") orelse return error.BadDFlyPack;
+    const digest = record.object.get("sha256") orelse return error.BadDFlyPack;
+    var wanted_name: [32]u8 = undefined;
+    const expected_name = try std.fmt.bufPrint(&wanted_name, "rank{d}.safetensors", .{rank});
+    if (name != .string or !std.mem.eql(u8, name.string, expected_name) or
+        size != .integer or size.integer < 0 or @as(u64, @intCast(size.integer)) != file.map.memory.len or
+        digest != .string or digest.string.len != 64) return error.BadDFlyPack;
+    var wanted_digest: [32]u8 = undefined;
+    _ = std.fmt.hexToBytes(&wanted_digest, digest.string) catch return error.BadDFlyPack;
+    var actual_digest: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(file.map.memory, &actual_digest, .{});
+    if (!std.mem.eql(u8, &wanted_digest, &actual_digest)) return error.DFlyPackChecksumMismatch;
+    var out: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &out, .{});
+    return out;
+}
+
+const Loader = struct {
+    w: *Weights,
+    d: *const cuda.Driver,
+    file: *const st.File,
+
+    fn tensor(l: *Loader, name: []const u8, dtype: st.DType, shape: []const usize) !u64 {
+        const t = l.file.get(name) orelse {
+            std.log.err("DFly2 missing tensor {s}", .{name});
+            return error.MissingDFlyTensor;
+        };
+        if (!t.is(dtype, shape)) {
+            std.log.err("DFly2 tensor has wrong dtype or shape: {s}", .{name});
+            return error.BadDFlyTensor;
+        }
+        try l.w.buffers.ensureUnusedCapacity(l.w.gpa, 1);
+        try l.w.named.ensureUnusedCapacity(l.w.gpa, 1);
+        const own_name = try l.w.gpa.dupe(u8, name);
+        errdefer l.w.gpa.free(own_name);
+        var buffer = try cuda.DeviceBuffer.alloc(l.d, t.bytes.len);
+        errdefer buffer.free();
+        try buffer.upload(0, t.bytes);
+        l.w.buffers.appendAssumeCapacity(buffer);
+        l.w.named.appendAssumeCapacity(.{ .name = own_name, .ptr = buffer.ptr, .len = buffer.len });
+        l.w.bytes += t.bytes.len;
+        return buffer.ptr;
+    }
+
+    fn linear(l: *Loader, name: []const u8, n: usize, k: usize) !Linear {
+        return plain(try l.tensor(name, .bf16, &.{ n, k }), n, k);
+    }
+
+    fn grouped(l: *Loader, name: []const u8) ![4]Linear {
+        const base = try l.tensor(name, .bf16, &.{ 4096, 4096 });
+        var out: [4]Linear = undefined;
+        for (&out, 0..) |*p, i| p.* = plain(base + i * 1024 * 4096 * 2, 1024, 4096);
+        return out;
+    }
+
+    fn fp4(l: *Loader, prefix: []const u8, n: usize, k: usize) !Mxfp4Experts {
+        var name: [192]u8 = undefined;
+        const codes = try l.tensor(try std.fmt.bufPrint(&name, "{s}.weight", .{prefix}), .u8, &.{ 128, n, k / 2 });
+        const scales = try l.tensor(try std.fmt.bufPrint(&name, "{s}.scale", .{prefix}), .u8, &.{ 128, n, k / 32 });
+        return .{ .codes = codes, .scales = scales, .count = 128, .n = @intCast(n), .k = @intCast(k) };
+    }
+
+    fn layer(l: *Loader, i: usize) !Layer {
+        var prefix: [64]u8 = undefined;
+        const p = try std.fmt.bufPrint(&prefix, "model.layers.{d}", .{i});
+        var name: [192]u8 = undefined;
+        var a: weights.Layer = .{ .idx = @intCast(40 + i), .ratio = 0 };
+        a.attn_norm = try l.tensor(try std.fmt.bufPrint(&name, "{s}.attn_norm.weight", .{p}), .bf16, &.{5120});
+        a.ffn_norm = try l.tensor(try std.fmt.bufPrint(&name, "{s}.ffn_norm.weight", .{p}), .bf16, &.{5120});
+        inline for (.{ .{ "attn", "hc_attn" }, .{ "ffn", "hc_ffn" } }) |kind| {
+            const dest = &@field(a, kind[1]);
+            dest[0] = try l.tensor(try std.fmt.bufPrint(&name, "{s}.hc_{s}_fn", .{ p, kind[0] }), .f32, &.{ 24, 20480 });
+            dest[1] = try l.tensor(try std.fmt.bufPrint(&name, "{s}.hc_{s}_scale", .{ p, kind[0] }), .f32, &.{3});
+            dest[2] = try l.tensor(try std.fmt.bufPrint(&name, "{s}.hc_{s}_base", .{ p, kind[0] }), .f32, &.{24});
+        }
+        a.wq_a = try l.linear(try std.fmt.bufPrint(&name, "{s}.attn.wq_a.weight", .{p}), 1280, 5120);
+        a.q_norm = try l.tensor(try std.fmt.bufPrint(&name, "{s}.attn.q_norm.weight", .{p}), .bf16, &.{1280});
+        a.wq_b = try l.linear(try std.fmt.bufPrint(&name, "{s}.attn.wq_b.weight", .{p}), 16384, 1280);
+        a.wkv = try l.linear(try std.fmt.bufPrint(&name, "{s}.attn.wkv.weight", .{p}), 512, 5120);
+        a.kv_norm = try l.tensor(try std.fmt.bufPrint(&name, "{s}.attn.kv_norm.weight", .{p}), .bf16, &.{512});
