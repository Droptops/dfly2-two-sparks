diff --git a/zig/src/core/lanes/engine_test.zig b/zig/src/core/lanes/engine_test.zig
index f1812fd..a153175 100644
--- a/zig/src/core/lanes/engine_test.zig
+++ b/zig/src/core/lanes/engine_test.zig
@@ -87,6 +87,80 @@ test "backend depth choices cannot increase the core budget" {
     try std.testing.expectError(error.DraftPolicyExceedsBudget, run(&.{.{ .prompt = &p1, .depth_policy = .invalid }}));
 }
 
+const InitialDepthProbe = struct {
+    target: fake.Fake,
+    cap: ?u32,
+    choices: usize = 0,
+
+    fn select(ptr: *anyopaque, _: *sm.Stream, allowed: u32) anyerror!u32 {
+        const target: *fake.Fake = @ptrCast(@alignCast(ptr));
+        const probe: *@This() = @fieldParentPtr("target", target);
+        probe.choices += 1;
+        // A stateful policy makes a duplicate initial selection observable.
+        const depth = probe.cap orelse switch (probe.choices) { 1 => 0, 2 => 1, else => allowed };
+        return @min(allowed, depth);
+    }
+};
+
+fn checkInitialDepth(cap: ?u32) !void {
+    var cfg = try model();
+    defer cfg.deinit(gpa);
+    var probe: InitialDepthProbe = .{ .target = .{ .gpa = gpa }, .cap = cap };
+    defer probe.target.deinit();
+    var clock: fake.FixedClock = .{};
+    var backend = probe.target.backend();
+    var vtable = backend.vtable.*;
+    vtable.draft_depth = InitialDepthProbe.select;
+    backend.vtable = &vtable;
+    var engine = Engine.init(gpa, &cfg, backend, clock.clock());
+    defer engine.deinit();
+    var stream = try sm.Stream.init(gpa, .{ .id = "initial-depth", .prompt = &p1, .max_new = 40, .eos = &.{} });
+    defer stream.deinit(gpa);
+
+    try engine.addStream(&stream);
+    const first = cap orelse 0;
+    try std.testing.expectEqual(@as(usize, 1), probe.choices);
+    try std.testing.expect(stream.next != null);
+    try std.testing.expectEqual(first, stream.next.?.count);
+    try std.testing.expectEqual(first, stream.held_levels);
+    try std.testing.expectEqual(@as(usize, first), probe.target.lanes.get(&stream).?.held.items.len);
+
+    if (cap == null) {
+        try engine.step();
+        try std.testing.expectEqual(@as(usize, 2), probe.choices);
+        try std.testing.expect(stream.next != null);
+        try std.testing.expectEqual(@as(u32, 1), stream.next.?.count);
+        try std.testing.expectEqual(@as(u32, 1), stream.held_levels);
+        try std.testing.expectEqual(@as(usize, 1), probe.target.lanes.get(&stream).?.held.items.len);
+    }
+    while (engine.activeCount() > 0) {
+        try engine.step();
+        if (cap) |limit| if (!stream.finished) {
+            try std.testing.expect(stream.next != null);
+            try std.testing.expect(stream.next.?.count <= limit);
+            try std.testing.expect(stream.held_levels <= limit);
+            try std.testing.expect(probe.target.lanes.get(&stream).?.held.items.len <= limit);
+        };
+    }
+    if (cap == 0) {
+        try std.testing.expectEqual(@as(u64, 0), stream.drafted);
+        try std.testing.expectEqual(@as(u64, 0), stream.accepted);
+        try std.testing.expectEqual(@as(u64, @intCast(stream.emitted().len - 1)), stream.rounds);
+    }
+}
+
+test "zero depth holds no initial drafts and verifies one token per round" {
+    try checkInitialDepth(0);
+}
+
+test "fixed one depth caps initial and subsequent held drafts" {
+    try checkInitialDepth(1);
+}
+
+test "adaptive depth selects once for the initial and next draft" {
+    try checkInitialDepth(null);
+}
