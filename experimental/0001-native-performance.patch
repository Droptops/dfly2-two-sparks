diff --git a/zig/src/families/dsv41/dfly_capture.zig b/zig/src/families/dsv41/dfly_capture.zig
new file mode 100644
index 0000000..2f2e3dc
--- /dev/null
+++ b/zig/src/families/dsv41/dfly_capture.zig
@@ -0,0 +1,99 @@
+//! Explicit, bounded diagnostic captures. Disabled unless a directory is supplied.
+//! Capturing synchronizes the stream; its timings must not be used as benchmarks.
+const std = @import("std");
+const prompt = @import("prompt.zig");
+const Engine = prompt.Engine;
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |s| std.mem.span(s) else null;
+}
+
+fn hashEnv(name: [:0]const u8) ![]const u8 {
+    const s = env(name) orelse return error.MissingCaptureProvenance;
+    if (s.len != 64) return error.BadCaptureProvenance;
+    for (s) |c| if (!((c >= '0' and c <= '9') or (c >= 'a' and c <= 'f'))) return error.BadCaptureProvenance;
+    return s;
+}
+
+pub const Capture = struct {
+    a: std.mem.Allocator,
+    io: std.Io,
+    root: []const u8,
+    binary_sha: []const u8,
+    requests_sha: []const u8,
+    limit: usize,
+    every: usize,
+    seen: usize = 0,
+    count: usize = 0,
+    active: ?[]const u8 = null,
+    q0: i64 = 0,
+    anchor: i64 = 0,
+
+    pub fn init(a: std.mem.Allocator, io: std.Io, rank: u32) !?Capture {
+        const root = env("TF_DFLY_CAPTURE_DIR") orelse return null;
+        if (rank != 0) return null;
+        if (!std.fs.path.isAbsolute(root)) return error.CaptureNeedsAbsolutePath;
+        const limit = try std.fmt.parseInt(usize, env("TF_DFLY_CAPTURE_LIMIT") orelse "4", 10);
+        const every = try std.fmt.parseInt(usize, env("TF_DFLY_CAPTURE_EVERY") orelse "1", 10);
+        if (limit == 0 or limit > 64 or every == 0 or every > 4096) return error.BadCaptureLimit;
+        return .{ .a = a, .io = io, .root = root, .limit = limit, .every = every,
+            .binary_sha = try hashEnv("TF_DFLY_CAPTURE_BINARY_SHA256"),
+            .requests_sha = try hashEnv("TF_DFLY_CAPTURE_REQUESTS_SHA256") };
+    }
+
+    pub fn begin(c: *Capture, q0: i64, anchor: i64, steps: usize) !void {
+        c.active = null;
+        const pass = c.seen;
+        c.seen += 1;
+        if (c.count >= c.limit or pass % c.every != 0) return;
+        if (steps != 5) return error.CaptureRequiresFiveDrafts;
+        const path = try std.fmt.allocPrint(c.a, "{s}/capture-{d:0>6}", .{ c.root, pass });
+        try std.Io.Dir.cwd().createDirPath(c.io, path);
+        const marker = try std.fs.path.join(c.a, &.{ path, "capture.started" });
+        var file = try std.Io.Dir.cwd().createFile(c.io, marker, .{ .exclusive = true });
+        file.close(c.io);
+        c.active = path;
+        c.q0 = q0;
+        c.anchor = anchor;
+        c.count += 1;
+    }
+
+    pub fn host(c: *Capture, name: []const u8, bytes: []const u8, offset: u64) !void {
+        const dir = c.active orelse return;
+        const path = try std.fmt.allocPrint(c.a, "{s}/{s}.bin", .{ dir, name });
+        var file = if (offset == 0)
+            try std.Io.Dir.cwd().createFile(c.io, path, .{ .exclusive = true })
+        else
+            try std.Io.Dir.cwd().openFile(c.io, path, .{ .mode = .read_write });
+        defer file.close(c.io);
+        try file.writePositionalAll(c.io, bytes, offset);
+    }
+
+    pub fn device(c: *Capture, e: *const Engine, name: []const u8, pointer: u64, bytes: usize, offset: u64) !void {
+        if (c.active == null) return;
+        try e.s.synchronize();
+        const host_bytes = try c.a.alloc(u8, bytes);
+        defer c.a.free(host_bytes);
+        try e.d.check(e.d.api.cuMemcpyDtoH_v2(host_bytes.ptr, pointer, bytes), "DFlyCaptureDtoH");
+        try c.host(name, host_bytes, offset);
+    }
+
+    pub fn finish(c: *Capture, e: *const Engine, identity: *const [32]u8, proposals: []const i64, reference_norms: bool) !void {
+        const dir = c.active orelse return;
+        if (proposals.len != 5) return error.CaptureRequiresFiveDrafts;
+        try c.host("proposals", std.mem.sliceAsBytes(proposals), 0);
+        for (0..6) |slot| {
+            const previous = if (slot < 2) c.anchor else proposals[slot - 2];
+            if (previous < 0 or previous >= e.c.vocab) return error.BadCaptureToken;
+            try c.device(e, "previous_embeddings", e.w.embed + @as(u64, @intCast(previous)) * 5120 * 2, 5120 * 2, slot * 5120 * 2);
+        }
+        const data = try std.fmt.allocPrint(c.a,
+            "{{\"schema\":\"dfly2-reference-capture-v1\",\"q0\":{d},\"anchor_token\":{d},\"steps\":5,\"world_size\":2,\"native\":{{\"binary_sha256\":\"{s}\",\"requests_sha256\":\"{s}\",\"checkpoint_manifest_sha256\":\"{x}\",\"rms_norm_eps\":{e},\"norm_rounding\":\"{s}\"}}}}\n",
+            .{ c.q0, c.anchor, c.binary_sha, c.requests_sha, identity, e.c.eps, if (reference_norms) "double" else "fused" });
+        const path = try std.fs.path.join(c.a, &.{ dir, "capture.json" });
+        var file = try std.Io.Dir.cwd().createFile(c.io, path, .{ .exclusive = true });
+        defer file.close(c.io);
+        try file.writePositionalAll(c.io, data, 0);
+        c.active = null;
+    }
+};
diff --git a/zig/src/families/dsv41/dfly_head_main.zig b/zig/src/families/dsv41/dfly_head_main.zig
new file mode 100644
index 0000000..a852f4b
--- /dev/null
+++ b/zig/src/families/dsv41/dfly_head_main.zig
@@ -0,0 +1,148 @@
+//! Diagnostic shared target head. No target layers, NCCL, services, or generation.
+//! Both rank-cache halves must be accessible on this machine; one half is loaded
+//! at a time, retaining its original TP2 EXL3 plan. Every input is scored at m=1.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const dsv41 = @import("dsv41");
+const linear = dsv41.exl3_linear;
+
+const hidden = 5120;
+const vocab = 129280;
+const half_vocab = vocab / 2;
+const max_rows = 128;
+
+const TopTwo = struct { token: usize, score: f32, runnerup_token: usize, runnerup_score: f32 };
+
+/// Ascending scan and strict comparison preserve the native lower-id tie break.
+fn topTwo(values: []const f32) !TopTwo {
+    if (values.len < 2) return error.TooFewLogits;
+    var best: usize = 0;
+    var next: usize = 1;
+    for (values) |value| if (!std.math.isFinite(value)) return error.NonfiniteLogits;
+    if (values[next] > values[best]) std.mem.swap(usize, &best, &next);
+    for (2..values.len) |i| {
+        if (values[i] > values[best]) {
+            next = best;
+            best = i;
+        } else if (values[i] > values[next]) {
+            next = i;
+        }
+    }
+    return .{ .token = best, .score = values[best], .runnerup_token = next, .runnerup_score = values[next] };
+}
+
+fn writeNew(io: std.Io, dir: std.Io.Dir, name: []const u8, bytes: []const u8) !void {
+    var file = try dir.createFile(io, name, .{ .exclusive = true });
+    defer file.close(io);
+    try file.writePositionalAll(io, bytes, 0);
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    if (builtin.cpu.arch.endian() != .little) return error.RequiresLittleEndian;
+    const a = init.arena.allocator();
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len != 7) {
+        std.debug.print("usage: tf-dsv41-dfly-head TARGET_MODEL_DIR RANK0_CACHE_FILE RANK1_CACHE_FILE GROUPED_CUBIN INPUT_BF16 OUTPUT_DIR\n", .{});
+        return 2;
+    }
+    const cfg = try dsv41.Config.read(a, io, args[1]);
+    if (cfg.hidden != hidden or cfg.vocab != vocab) return error.UnexpectedTargetShape;
+    const input = try std.Io.Dir.cwd().readFileAlloc(io, args[5], a, .limited(max_rows * hidden * 2));
+    if (input.len == 0 or input.len % (hidden * 2) != 0) return error.BadInputRows;
+    const rows = input.len / (hidden * 2);
+    for (0..input.len / 2) |i| {
+        const bf = std.mem.readInt(u16, input[2 * i ..][0..2], .little);
+        if ((bf & 0x7f80) == 0x7f80) return error.NonfiniteInput;
+    }
+    const cubin = try std.Io.Dir.cwd().readFileAllocOptions(io, args[4], a, .limited(1 << 28), .@"16", null);
+    // Refuse an existing output directory, preserving every earlier diagnostic.
+    try std.Io.Dir.cwd().createDir(io, args[6], .default_dir);
+    var out = try std.Io.Dir.cwd().openDir(io, args[6], .{});
+    defer out.close(io);
+    try writeNew(io, out, "head.started", "dfly2-head-probe-v1\n");
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var context = try cuda.Context.init(&driver, 0);
+    defer context.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var kernels = try linear.Kernels.load(&driver, cubin);
+    defer kernels.unload();
+    var x = try cuda.DeviceBuffer.alloc(&driver, hidden * 2);
+    defer x.free();
+    var xh = try cuda.DeviceBuffer.alloc(&driver, hidden * 2);
+    defer xh.free();
+    var y = try cuda.DeviceBuffer.alloc(&driver, half_vocab * 4);
+    defer y.free();
+    var counters = try cuda.DeviceBuffer.alloc(&driver, 8 * (half_vocab / 128) * 4);
+    defer counters.free();
+    const logits = try a.alloc(f32, rows * vocab);
+    var halves: [2]struct { k2: u32, sk: u32, wk: u32, bytes: u64 } = undefined;
+    for (0..2) |rank| {
+        // The rank cache parser reads only its small trailing index. loadHead then
+        // reads the three head tensors, without prefetching unrelated target data.
+        const cache_path = args[2 + rank];
+        var ix = try dsv41.rank_cache.open(init.gpa, io, std.Io.Dir.cwd(), cache_path);
+        defer ix.deinit();
+        var file = try std.Io.Dir.cwd().openFile(io, cache_path, .{});
+        defer file.close(io);
+        var w = try dsv41.weights.loadHead(init.gpa, &driver, .{ .cache = .{ .file = file, .index = &ix, .io = io } }, cfg, .{ .rank = @intCast(rank), .world = 2 });
+        defer w.deinit();
+        // Loader uploads are synchronous pageable copies on the default stream;
+        // finish their DMA before the nonblocking diagnostic stream reads them.
+        try context.synchronize();
+        const p = linear.plan(w.head.k, w.head.n);
+        halves[rank] = .{ .k2 = w.head.k2, .sk = p.sk, .wk = p.wk, .bytes = w.bytes };
+        var z = try cuda.DeviceBuffer.alloc(&driver, linear.zFloats(&.{w.head}, 1) * 4);
+        defer z.free();
+        for (0..rows) |row| {
+            try x.uploadAsync(0, input[row * hidden * 2 ..][0 .. hidden * 2], stream.handle);
+            try xh.fill8(0, stream.handle);
+            try y.fill32(0x7fc00000, stream.handle); // detect unwritten output
+            try counters.fill32(0, stream.handle);
+            try z.fill32(0, stream.handle);
+            const calls = [_]linear.Call{.{ .layer = w.head, .x = x.ptr, .ldx = hidden, .x_dtype = .bf16,
+                .xh = xh.ptr, .y = y.ptr, .ldy = half_vocab, .y_dtype = .f32, .counters = counters.ptr }};
+            // Exact serving grouped path: BF16 input, FP16 rotation, F32 head,
+            // original half's split-K plan, PDL and L2 discard flags unchanged.
+            try linear.rotMany(&kernels, stream, &calls, 1, true);
+            try linear.glinear(&kernels, stream, &calls, 1, z.ptr, true, true);
+            try stream.synchronize();
+            const start = row * vocab + rank * half_vocab;
+            try y.download(0, std.mem.sliceAsBytes(logits[start..][0..half_vocab]));
+        }
+    }
+    try writeNew(io, out, "logits.bin", std.mem.sliceAsBytes(logits));
+    var input_sha: [32]u8 = undefined;
+    var cubin_sha: [32]u8 = undefined;
+    var logits_sha: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(input, &input_sha, .{});
+    std.crypto.hash.sha2.Sha256.hash(cubin, &cubin_sha, .{});
+    std.crypto.hash.sha2.Sha256.hash(std.mem.sliceAsBytes(logits), &logits_sha, .{});
+    var json: std.ArrayList(u8) = .empty;
+    defer json.deinit(a);
+    try json.print(a, "{{\"schema\":\"dfly2-head-probe-v1\",\"rows\":{d},\"vocab\":{d},\"m_per_launch\":1,\"input_sha256\":\"{x}\",\"cubin_sha256\":\"{x}\",\"logits_sha256\":\"{x}\",\"sm\":{d},\"halves\":[", .{ rows, vocab, &input_sha, &cubin_sha, &logits_sha, try context.capability() });
+    for (halves, 0..) |h, rank| try json.print(a, "{s}{{\"rank\":{d},\"vocab_lo\":{d},\"vocab_hi\":{d},\"k2\":{d},\"sk\":{d},\"wk\":{d},\"device_weight_bytes\":{d}}}", .{ if (rank == 0) "" else ",", rank, rank * half_vocab, (rank + 1) * half_vocab, h.k2, h.sk, h.wk, h.bytes });
+    try json.appendSlice(a, "],\"results\":[");
+    for (0..rows) |row| {
+        const top = try topTwo(logits[row * vocab ..][0..vocab]);
+        try json.print(a, "{s}{{\"token\":{d},\"score\":{e},\"runnerup_token\":{d},\"runnerup_score\":{e},\"margin\":{e}}}", .{ if (row == 0) "" else ",", top.token, top.score, top.runnerup_token, top.runnerup_score, top.score - top.runnerup_score });
+    }
+    try json.appendSlice(a, "]}\n");
+    // Completion marker last, only after all logits are finite and top2 is valid.
+    try writeNew(io, out, "top1.json", json.items);
+    std.debug.print("head probe: {d} rows scored through both TP2 EXL3 halves\n", .{rows});
+    return 0;
+}
+
+test "head top two retain the lower token on ties and reject nonfinite logits" {
+    const t = try topTwo(&.{ 2, 5, 5, 1 });
+    try std.testing.expectEqual(@as(usize, 1), t.token);
+    try std.testing.expectEqual(@as(usize, 2), t.runnerup_token);
+    const u = try topTwo(&.{ 5, 5, 1, 5 });
+    try std.testing.expectEqual(@as(usize, 0), u.token);
+    try std.testing.expectEqual(@as(usize, 1), u.runnerup_token);
+    try std.testing.expectError(error.NonfiniteLogits, topTwo(&.{ 1, std.math.nan(f32) }));
+}
