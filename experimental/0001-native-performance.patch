 }
+
+// Device-feedback variants preserve the original BF16 math and selection order.
+// A corrupt/invalid proposal is retained as -1 in ids and checked on the host
+// at the end of the pass. Its embedding read is clamped solely to avoid OOB.
+extern "C" __global__ void tf_dfly_norm_concat_indexed(const B* x,const B* embed,
+    const int64_t* ids,const B* wx,const B* wy,B* out,int d,int at,int vocab,float eps) {
+    int64_t token=ids[at];
+    const B* y=embed+(token>=0 && token<vocab ? token:0)*int64_t(d);
+    float sx=0,sy=0;
+    for(int i=threadIdx.x;i<d;i+=blockDim.x) { float a=bf(x[i]),b=bf(y[i]);sx+=a*a;sy+=b*b; }
+    sx=rsqrtf(block_sum(sx)/d+eps);sy=rsqrtf(block_sum(sy)/d+eps);
+    for(int i=threadIdx.x;i<d;i+=blockDim.x) {out[i]=rb(bf(x[i])*sx*bf(wx[i]));out[d+i]=rb(bf(y[i])*sy*bf(wy[i]));}
+}
+
+extern "C" __global__ void tf_dfly_pad_best(float* best) {
+    if(!threadIdx.x) {best[2]=0.f;best[3]=0.f;}
+}
+
+extern "C" __global__ void tf_dfly_select_best(const float* best,int64_t* ids,
+                                              int slot,int vocab,int stride) {
+    if(threadIdx.x) return;
+    bool second=best[stride]>best[0] || (best[stride]==best[0] && best[stride+1]<best[1]);
+    float token=best[second ? stride+1:1];
+    ids[slot]=isfinite(token) && token>=0 && token<vocab && token==floorf(token) ? int64_t(token):-1;
+}
+
+// Opt-in DFlashRMSNorm materialization. Keep the original fused kernels and
+// their argument ABI unchanged for control runs and existing primitive tests.
+extern "C" __global__ void tf_dfly_norm_concat_reference(const B* x,const B* y,
+    const B* wx,const B* wy,B* out,int d,float eps) {
+    float sx=0,sy=0;
+    for(int i=threadIdx.x;i<d;i+=blockDim.x) {float a=bf(x[i]),b=bf(y[i]);sx+=a*a;sy+=b*b;}
+    sx=rsqrtf(block_sum(sx)/d+eps);sy=rsqrtf(block_sum(sy)/d+eps);
+    for(int i=threadIdx.x;i<d;i+=blockDim.x) {
+        out[i]=rb(bf(rb(bf(x[i])*sx))*bf(wx[i]));
+        out[d+i]=rb(bf(rb(bf(y[i])*sy))*bf(wy[i]));
+    }
+}
+
+extern "C" __global__ void tf_dfly_norm_concat_indexed_reference(const B* x,const B* embed,
+    const int64_t* ids,const B* wx,const B* wy,B* out,int d,int at,int vocab,float eps) {
+    int64_t token=ids[at];
+    const B* y=embed+(token>=0 && token<vocab ? token:0)*int64_t(d);
+    float sx=0,sy=0;
+    for(int i=threadIdx.x;i<d;i+=blockDim.x) {float a=bf(x[i]),b=bf(y[i]);sx+=a*a;sy+=b*b;}
+    sx=rsqrtf(block_sum(sx)/d+eps);sy=rsqrtf(block_sum(sy)/d+eps);
+    for(int i=threadIdx.x;i<d;i+=blockDim.x) {
+        out[i]=rb(bf(rb(bf(x[i])*sx))*bf(wx[i]));
+        out[d+i]=rb(bf(rb(bf(y[i])*sy))*bf(wy[i]));
+    }
+}
+
+// x already holds BF16(x * RMS scale) from a unit-weight existing norm.
+// Both operands are BF16, so the product materializes the second BF16 round.
+extern "C" __global__ void tf_dfly_norm_weight(B* x,const B* weight,int n,int d) {
+    for(int i=blockIdx.x*blockDim.x+threadIdx.x;i<n;i+=blockDim.x*gridDim.x)
+        x[i]=rb(bf(x[i])*bf(weight[i%d]));
+}
