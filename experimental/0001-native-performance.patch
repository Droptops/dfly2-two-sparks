+++ b/zig/src/families/dsv41/dfly_profile.zig
@@ -0,0 +1,114 @@
+//! Optional stream-timeline diagnostics for DFly2. Disabled in speed benchmarks.
+//! Event gaps include GPU execution, collective waits and host enqueue gaps;
+//! they are NOT exclusive kernel execution times. Categories do not nest.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Category = enum {
+    context,
+    fusion,
+    mixing,
+    attention,
+    route,
+    routed_moe,
+    shared_moe,
+    correction_input,
+    correction_mlp,
+    correction_attention,
+    correction_merge,
+    head,
+    argmax,
+    collective,
+    feedback_gap,
+};
+const categories = @typeInfo(Category).@"enum".field_names.len;
+const max_intervals = 160;
+const Interval = struct { start: cuda.Event, end: cuda.Event, category: Category = .context };
+
+pub const Profile = struct {
+    enabled: bool = false,
+    events: [max_intervals]Interval = undefined,
+    made: usize = 0,
+    used: usize = 0,
+    passes: usize = 0,
+    pass_ms: f64 = 0,
+    depths: [6]usize = @splat(0),
+    ms: [categories]f64 = @splat(0),
+    calls: [categories]usize = @splat(0),
+    host_readbacks: usize = 0,
+
+    pub fn init(d: *const cuda.Driver, enabled: bool) !Profile {
+        var p: Profile = .{ .enabled = enabled };
+        if (!enabled) return p;
+        errdefer p.deinit();
+        for (&p.events) |*event| {
+            event.start = try cuda.Event.init(d, true);
+            event.end = cuda.Event.init(d, true) catch |err| {
+                event.start.deinit();
+                return err;
+            };
+            p.made += 1;
+        }
+        return p;
+    }
+
+    pub fn deinit(p: *Profile) void {
+        for (p.events[0..p.made]) |*event| {
+            event.start.deinit();
+            event.end.deinit();
+        }
+        p.made = 0;
+    }
+
+    pub fn begin(p: *Profile, s: cuda.Stream, category: Category) !?usize {
+        if (!p.enabled) return null;
+        if (p.used == p.events.len - 1) return error.DFly2ProfileCapacity;
+        const i = p.used;
+        p.used += 1;
+        p.events[i].category = category;
+        try p.events[i].start.record(s);
+        return i;
+    }
+
+    pub fn end(p: *Profile, s: cuda.Stream, interval: ?usize) !void {
+        if (interval) |i| try p.events[i].end.record(s);
+    }
+
+    pub fn startPass(p: *Profile, s: cuda.Stream) !void {
+        if (!p.enabled) return;
+        if (p.used != 0) return error.DFly2ProfileIncompletePass;
+        try p.events[max_intervals - 1].start.record(s);
+    }
+
+    pub fn finish(p: *Profile, s: cuda.Stream, steps: usize) !void {
+        if (!p.enabled) return;
+        try p.events[max_intervals - 1].end.record(s);
+        // Called after proposal readback. The last event may follow that host
+        // wait, so finish it before inspecting timestamps or reusing events.
+        try s.synchronize();
+        p.pass_ms += @as(f64, try cuda.Event.elapsedMs(p.events[max_intervals - 1].start, p.events[max_intervals - 1].end));
+        for (p.events[0..p.used]) |*event| {
+            const at = @intFromEnum(event.category);
+            p.ms[at] += @as(f64, try cuda.Event.elapsedMs(event.start, event.end));
+            p.calls[at] += 1;
+        }
+        p.used = 0;
+        p.passes += 1;
+        p.depths[steps] += 1;
+    }
+
+    pub fn writeSummary(p: *const Profile, w: *std.Io.Writer, rank: usize) !void {
+        if (!p.enabled) return;
+        try w.print("{{\"rank\":{d},\"dfly2_profile\":{{\"schema\":\"dfly2-stream-profile-v1\",\"passes\":{d},\"total_pass_ms\":{d:.6},\"host_readbacks\":{d},\"depths\":[", .{ rank, p.passes, p.pass_ms, p.host_readbacks });
+        for (p.depths, 0..) |n, i| {
+            if (i != 0) try w.writeAll(",");
+            try w.print("{d}", .{n});
+        }
+        try w.writeAll("],\"categories\":{");
+        inline for (@typeInfo(Category).@"enum".field_names, 0..) |name, i| {
+            if (i != 0) try w.writeAll(",");
+            try w.print("\"{s}\":{{\"calls\":{d},\"total_ms\":{d:.6}}}", .{ name, p.calls[i], p.ms[i] });
+        }
+        try w.writeAll("},\"scope\":\"elapsed stream intervals, including enqueue gaps; instrumentation enabled\"}}\n");
+    }
+};
