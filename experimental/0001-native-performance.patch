index 0000000..fc579b2
--- /dev/null
+++ b/zig/src/families/dsv41/dfly_policy.zig
@@ -0,0 +1,176 @@
+//! Opt-in, per-request DFly depth selection. Verification and drafting are timed
+//! separately so a change in the next depth cannot contaminate the previous cost.
+//! Six bounded calibration decisions measure depths 0..5, then a 5% margin
+//! protects plain decoding. Every 16 decisions a rotating depth is probed.
+//! No confidence-head probabilities are fabricated: survival is observed from
+//! exact accepted prefixes. This changes proposals only, never target sampling.
+const std = @import("std");
+
+pub const max_depth = 5;
+const calibration = [_]usize{ 0, 5, 1, 2, 3, 4 };
+pub const prior = [_]f64{ 0.85, 0.75, 0.70, 0.65, 0.60 };
+
+pub const Mean = struct {
+    value: f64 = 0,
+    count: u64 = 0,
+    pub fn add(m: *Mean, value: f64) !void {
+        if (!std.math.isFinite(value) or value <= 0) return error.BadPolicyTiming;
+        m.value = if (m.count == 0) value else m.value + 0.2 * (value - m.value);
+        m.count += 1;
+    }
+};
+
+pub const State = struct {
+    survival: [max_depth]f64 = prior,
+    tried: [max_depth]u64 = @splat(0),
+    accepted: [max_depth]u64 = @splat(0),
+    verify: [max_depth + 1]Mean = @splat(.{}),
+    draft: [max_depth + 1]Mean = @splat(.{}),
+    chosen: [max_depth + 1]u64 = @splat(0),
+    decisions: u64 = 0,
+    calibrations: u64 = 0,
+    probes: u64 = 0,
+    next_probe: usize = 0,
+
+    pub fn observeVerify(s: *State, proposed: usize, kept: usize, ms: f64) !void {
+        if (proposed > max_depth or kept > proposed) return error.BadPolicyObservation;
+        try s.verify[proposed].add(ms);
+        // A rejected prefix supplies no observation about its later positions.
+        for (0..@min(proposed, kept + 1)) |j| {
+            const hit: f64 = if (j < kept) 1 else 0;
+            s.tried[j] += 1;
+            s.accepted[j] += @intFromBool(j < kept);
+            s.survival[j] += 0.15 * (hit - s.survival[j]);
+        }
+    }
+
+    pub fn observeDraft(s: *State, depth: usize, ms: f64) !void {
+        if (depth == 0 or depth > max_depth) return error.BadPolicyObservation;
+        try s.draft[depth].add(ms);
+    }
+
+    pub fn expected(s: *const State, depth: usize) f64 {
+        var out: f64 = 1;
+        var p: f64 = 1;
+        for (s.survival[0..depth]) |x| {
+            p *= x;
+            out += p;
+        }
+        return out;
+    }
+
+    fn cost(s: *const State, depth: usize, forward_ms: [max_depth + 1]f64) f64 {
+        const target = if (s.verify[depth].count > 0) s.verify[depth].value else forward_ms[depth];
+        if (depth == 0) return target;
+        // Before a depth is measured, conservatively charge the largest observed
+        // pass, or the old integration's 28 ms seed. Calibration replaces this.
+        var fallback: f64 = 28;
+        var have = false;
+        for (s.draft[1..]) |m| if (m.count > 0) {
+            fallback = if (have) @max(fallback, m.value) else m.value;
+            have = true;
+        };
+        return target + if (s.draft[depth].count > 0) s.draft[depth].value else fallback;
+    }
+
+    pub fn choose(s: *State, allowed: usize, forward_ms: [max_depth + 1]f64) !usize {
+        if (allowed > max_depth) return error.BadPolicyDepth;
+        for (forward_ms) |ms| if (!std.math.isFinite(ms) or ms <= 0) return error.BadPolicyTiming;
+        var choice: usize = 0;
+        if (allowed > 0) {
+            if (s.decisions < calibration.len) {
+                choice = @min(allowed, calibration[@intCast(s.decisions)]);
+                s.calibrations += 1;
+            } else if ((s.decisions - calibration.len + 1) % 16 == 0) {
+                choice = @min(allowed, s.next_probe);
+                s.next_probe = (s.next_probe + 1) % (max_depth + 1);
+                s.probes += 1;
+            } else {
+                var best = 1.05 / s.cost(0, forward_ms);
+                for (1..allowed + 1) |depth| {
+                    const rate = s.expected(depth) / s.cost(depth, forward_ms);
+                    if (rate > best) {
+                        best = rate;
+                        choice = depth;
+                    }
+                }
+            }
+        }
+        s.decisions += 1;
+        s.chosen[choice] += 1;
+        return choice;
+    }
+
+    pub fn writeSummary(s: *const State, w: *std.Io.Writer, request: usize) !void {
+        try w.print("{{\"rank\":0,\"request\":{d},\"dfly_policy\":{{\"schema\":\"observed-depth-v1\",\"decisions\":{d},\"calibrations\":{d},\"probes\":{d},\"chosen_depth_counts\":[", .{ request, s.decisions, s.calibrations, s.probes });
+        for (s.chosen, 0..) |x, i| try w.print("{s}{d}", .{ if (i == 0) "" else ",", x });
+        try w.print("],\"conditional_survival\":[", .{});
+        for (s.survival, 0..) |x, i| try w.print("{s}{d:.6}", .{ if (i == 0) "" else ",", x });
+        try w.print("],\"tried\":[", .{});
+        for (s.tried, 0..) |x, i| try w.print("{s}{d}", .{ if (i == 0) "" else ",", x });
+        try w.print("],\"accepted\":[", .{});
+        for (s.accepted, 0..) |x, i| try w.print("{s}{d}", .{ if (i == 0) "" else ",", x });
+        try w.print("],\"verify_costs\":[", .{});
+        for (s.verify, 0..) |x, i| try w.print("{s}{{\"n\":{d},\"ewma_ms\":{d:.6}}}", .{ if (i == 0) "" else ",", x.count, x.value });
+        try w.print("],\"draft_costs\":[", .{});
+        for (s.draft, 0..) |x, i| try w.print("{s}{{\"n\":{d},\"ewma_ms\":{d:.6}}}", .{ if (i == 0) "" else ",", x.count, x.value });
+        try w.print("]}}}}\n", .{});
+    }
+};
+
+const forward = [_]f64{ 26, 31, 36, 41, 46, 51 };
+
+test "prefix rejection leaves unobserved later positions untouched" {
+    var s: State = .{};
+    try s.observeVerify(5, 1, 52);
+    try std.testing.expectEqualSlices(u64, &.{ 1, 1, 0, 0, 0 }, &s.tried);
+    try std.testing.expectEqualSlices(u64, &.{ 1, 0, 0, 0, 0 }, &s.accepted);
+    try std.testing.expect(s.survival[0] > prior[0]);
+    try std.testing.expect(s.survival[1] < prior[1]);
+    try std.testing.expectEqual(prior[2], s.survival[2]);
+}
+
+test "calibration measures plain and each draft depth once" {
+    var s: State = .{};
+    for (calibration) |d| try std.testing.expectEqual(d, try s.choose(5, forward));
+    try std.testing.expectEqualSlices(u64, &.{ 1, 1, 1, 1, 1, 1 }, &s.chosen);
+}
+
+test "low acceptance selects plain with bounded recurring probes" {
+    var s: State = .{ .survival = @splat(0.1), .decisions = calibration.len };
+    try std.testing.expectEqual(@as(usize, 0), try s.choose(5, forward));
+    for (0..96) |_| _ = try s.choose(5, forward);
+    try std.testing.expectEqual(@as(u64, 6), s.probes);
+    try std.testing.expect(s.chosen[5] > 0);
+    try std.testing.expect(s.chosen[0] > 80);
+}
+
+test "high acceptance and measured cheap drafting select deep drafting" {
+    var s: State = .{ .survival = @splat(0.99), .decisions = calibration.len };
+    for (1..6) |d| try s.observeDraft(d, 1);
+    try std.testing.expectEqual(@as(usize, 5), try s.choose(5, forward));
+}
+
+test "separate costs do not charge a following short pass to the prior deep verify" {
+    var s: State = .{};
+    try s.observeVerify(5, 3, 51);
+    try s.observeDraft(1, 12);
+    try std.testing.expectEqual(@as(f64, 51), s.verify[5].value);
+    try std.testing.expectEqual(@as(f64, 12), s.draft[1].value);
+    try std.testing.expectEqual(@as(u64, 0), s.draft[5].count);
+}
+
+test "policy never exceeds allowed depth including plain-only decisions" {
+    var s: State = .{};
+    for (0..100) |_| try std.testing.expect((try s.choose(2, forward)) <= 2);
+    try std.testing.expectEqual(@as(usize, 0), try s.choose(0, forward));
+}
+
+test "invalid observations fail before changing policy" {
+    var s: State = .{};
+    try std.testing.expectError(error.BadPolicyObservation, s.observeVerify(2, 3, 10));
+    try std.testing.expectError(error.BadPolicyTiming, s.observeVerify(2, 1, std.math.nan(f64)));
+    try std.testing.expectError(error.BadPolicyDepth, s.choose(6, forward));
+    try std.testing.expectEqual(@as(u64, 0), s.verify[2].count);
+    try std.testing.expectEqual(@as(u64, 0), s.decisions);
+}
