 };
 
 /// Every tensor of rank `s` on device `d`, from `src` (weights.py _load, in its order).
+/// Diagnostic-only loader for a TP2 vocabulary half. Reuses the serving loader's
+/// trellis conversion and uploads, without reading target layers or embeddings.
+pub fn loadHead(gpa: std.mem.Allocator, d: *const cuda.Driver, src: Source, c: Config, s: plan.Split) !Weights {
+    if (s.world != 2 or s.rank > 1 or s.pair != null) return error.HeadProbeNeedsTP2;
+    if (src != .cache) return error.HeadProbeNeedsRankCache;
+    const vr = s.headCols(c);
+    var key: [256]u8 = undefined;
+    const tr = src.cache.index.get(try plan.partKey(&key, "head", vr, null, "tr")) orelse return error.MissingEntry;
+    if (tr.dtype != .i16 or tr.rank != 3 or tr.dim(0) * 16 != c.hidden or tr.dim(1) * 16 != vr[1] - vr[0]) return error.UnexpectedTensor;
+    if (tr.dim(2) == 0 or tr.dim(2) % 8 != 0 or tr.dim(2) / 8 > 16) return error.UnexpectedTensor;
+    for ([_][]const u8{ "suh", "svh" }, [_]usize{ c.hidden, vr[1] - vr[0] }) |part, width| {
+        const entry = src.cache.index.get(try plan.partKey(&key, "head", vr, null, part)) orelse return error.MissingEntry;
+        if (entry.dtype != .f16 or entry.rank != 1 or entry.dim(0) != width) return error.UnexpectedTensor;
+    }
+    var w: Weights = .{ .gpa = gpa };
+    errdefer w.deinit();
+    var loader: Loader = .{ .gpa = gpa, .d = d, .src = src, .w = &w };
+    defer loader.deinit();
+    w.head = try loader.linear("head", vr, null);
+    w.vocab_lo = vr[0];
+    w.vocab_hi = vr[1];
+    return w;
+}
